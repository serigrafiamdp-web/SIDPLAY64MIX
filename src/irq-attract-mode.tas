;--------------------------------------------------------------
;Attract mode irq smooth scroller, when selecting colors.
;--------------------------------------------------------------
;attract_mode

;---------- ZEROPAGES -----------------------------------------
scrl1				= $ff
;--------------------------------------------------------------

-		lda $d012
		bne -
		sei
		lda #>attirq
		sta $ffff
		;lda #>atthwirq
		sta $0315
		lda #<attirq
		sta $fffe
		lda #<atthwirq
		sta $0314
		lda #$7f
		sta $dc0d
		lda #(sprite1&$3fff)/64
		sta screen2+$03f9
		sta screen2+$03fb
		lda #(sprite2&$3fff)/64
		sta screen2+$03f8
		sta screen2+$03fa
		
		ldx #$1d
-		lda vic,x
		sta $d000,x
		dex
		bpl -
		ldx #$c8
		stx scrl1

		dec $d019
		bit $dc0d
		cli
		rts

attirq		pha
		txa
		pha
		tya
		pha
atthwirq	lda $01
		pha
		lda #$36
		sta $01
		ldx scrl1
		stx $d016


		
		lda $d021
		sta $d028
		sta $d02a
		lda $d800+(40*23)
		sta $d027
		lda $d800+(40*23)+39
		sta $d029
		
		inc $d019

-		lda $d012
		cmp #$f4
		bcc -
		
		lda #$c8
		sta $d016

stmr		lda #$7f	;1-7f is stop scroller
		beq scroll
		dec stmr+1
		bpl nscrl

scroll
		lda scrl1
		sec
spd		sbc #$01
		tax
		and #$07
		ora #$c8
		sta scrl1
		cpx scrl1
		bcs nscrl

		ldx #$00
sl1		lda screen2+1+(40*23)+1,x
		sta screen2++1+(40*23),x
		;lda #scroll_color
		;sta $d800+(screen&$03ff)+$01e0,x
		inx
		cpx #$26
		bne sl1
ok1
		inc fetch+1
		bne fetch
		inc fetch+2

fetch		lda text
		beq rst
		bpl go1
		ldx spd+1
		and #$07
		sta spd+1
		bne uff
		lda #$7f			;stop scroller for 127 frames
		sta stmr+1
		stx spd+1
		bne uff
rst		lda #<text
		ldx #>text
		sta fetch+1
		stx fetch+2
uff		lda #$20			;"Space"
go1		sta screen2+(40*23)+38

nscrl

		jsr $ea87
		pla
		sta $01
		pla
		tay
		pla
		tax
		pla
		rti

xp
yp	= $e8
vic     
.byte $18,yp 		;d000,d001
.byte $15,yp		;d002,d003 black layer
.byte $50,yp		;d004,d005
.byte $50,yp		;d006,d007 black layer
.byte $00,$00
.byte $00,$00
.byte $00,$00
.byte $00,$00
.byte %00001100		;d010
.byte $1b		;d011
.byte $e8		;d012
.byte $00		;d013
.byte $00
.byte %00001111		;d015
.byte $c8,$00,$18	;d016,17,18
.byte $00		;d019
.byte $01		;d01a
.byte $00		;d01b
.byte $00		;d01c
.byte $00		;d01d


text
.enc screen

;-----|123456789012345678901234567890123456789|
.if defset=1					;normal
.text " This version works best on serial disk "
.text "drives like the 1541, 1571, 1581 etc.  ",$80
 .if def_REU
.text "  A 512 kb REU allows you to have 4096 "
.text "filenames present in REU memory.",$80
 .else
.text " You can have 171 filenames in memory.",$80
 .fi
.text "Using a fastload cartridge such as the Action Replay, Retro Replay, TFC, Epyx Fastload etc. is  highly recommended. "
.fi ;defset1

;-----|123456789012345678901234567890123456789|
.if defset=2
.text " Welcome to SIDPLAY64 for the 1541 Ultimate II. ",$80,$82
.text " This version utilizes the REU capabilties together with the Command Interface of the 1541U-II.    Almost no limits on how many files you can have in a directory.   "
.text "Instant directory and file loading.     You need the latest firmware, although all version from v2.6d and upwards should work.   ",$81
.text "   This special edition was programmed by:   GRG/SHAPE/[N0] and Tom-Cat/[N0].  ",$80,$82

.fi;defset2

;-----|123456789012345678901234567890123456789|
.if defset=3
.text " This version works best on *IEC* devices, but also IDE64(+ pclink), CMD FD, CMD HD, CMD Ramlink/Ramdrive. ",$80
.if def_REU
.text "  A 512 kb REU allows you to have 4096 "
.text "filenames present in REU memory.",$80
 .else
.text " You can have 171 filenames in memory.",$80
 .fi
.fi;defset3

;-----|123456789012345678901234567890123456789|
.if defset=4
.text " Welcome to the SD2IEC version, it allows you to mount disk images like .D64 .D71 .D81 and .DNP ",$80
.if def_REU
.text "  A 512 kb REU allows you to have 4096 "
.text "filenames present in REU memory.",$80
 .else
.text " You can have 171 filenames in memory.",$80
 .fi
.fi;defset4

;-----|123456789012345678901234567890123456789|
.if defset=5
.text " The 1541U works best in iec/standalone mode. It can mount .d64 images and browse dirs. ",$80
.text "If you use The Final Replay together with Netdrive (on the pc) you can load sid files directly from your PC hard drive via your LAN. "
.if def_REU
.text "  A 512 kb REU allows you to have 4096 "
.text "filenames present in REU memory.",$80
 .else
.text "   You can have 171 filenames in memory.",$80
 .fi
.fi;defset5


.byte $83
;-----|123456789012345678901234567890123456789|
.text "       S : Toggles screen on/off.      ",$80
.text "          ",$1f," : Fast Forward.           ",$80
.text "     CBM : Exit Rsid's (if possible).  ",$80,$82
.text "Both playlist modes",$81,"(Play Next and Play Random) can be selected by pressing 'M'.  ",$80

;--------------------------------------------------------------
.text "  Support this tool by visiting : "
.text "https://sourceforge.net/projects/sidplay64/",$80,$80,$80
.text "                                      "
;--------------------------------------------------------------
.byte 0	;end byte for scroller

.enc none

		