;--------------------------------------------------------------
; REU RANDOM routine
;--------------------------------------------------------------
;	* static subroutines
;	* location: d000-e000
;--------------------------------------------------------------


;plt_random

;valuelo = seed
;valuehi = seed+1

		lax maxfilehi
		bne +
		;A=0
		;x=0
		;sta svaluehi
		sta rseed+1		
		
newrand		lda rseed		;| random routine from WhiteFlame
		beq ldoeor
		asl
		beq lnoeor		;if the input was $80, skip the eor
		bcc lnoeor
ldoeor		eor #$1d
lnoeor		sta rseed

		cmp maxfile
		bcs newrand
		tay		;sta valuelo
		;x=0 valuehi
		jmp contt		;bcc for JMP ?
		
+

newrand2	jsr get_random_16bit
		ldy rseed		;valuelo
		lax rseed+1		;valuehi
		cpy maxfile
		sbc maxfilehi
		bcs newrand2
		

;this position is also called by the "remember dir" routine in "reu_remember_dir_position.tas"
contt
		;sty valuelo
		;stx valuehi

;x= valuehi
;y= valuelo
		
; check if the seed value is within the visible dir area: 
; if so we transfer the seed value (0-0f) to pos_cursor
; and zero the seed value so we can transfer the very first page of dir from reu:
		txa			;lda valuehi
		bne +
		;x=0
		tya			;lda valuelo
		;tay
		sec
		sbc #maxDirY
		bcs +			;check if we are at upper visible area (0000-000f)
		;lda #0
		;x=0
		stx fcounthi
		;sta valuehi		;already 0
		;stx valuelo
		sty pos_cursor		;y=00 to 0e
		sty fcountlo
		txa			;A+X=0
		tay			;y=0
		jmp slsb_AX		;input: A,Y
+		

; seed value is greater than #maxDirY :

		lda maxfile
		sec
		sbc #maxDirY-1
		sta tmplo
		lda maxfilehi
		sbc #0
		sta tmphi

		sty fcountlo		;=valuelo
		stx fcounthi		;=valuehi

					;ldy valuelo
		cpy tmplo
		txa			;ldx valuehi
		sbc tmphi
		bcc +
		
		ldy #maxDirY-1
		ldx maxfile
-
		cpx fcountlo		;valuelo
		beq hh
		dex
		dey
		bne -
hh		sty pos_cursor

		;lda valuelo
		;sta fcountlo
		;lda valuehi
		;sta fcounthi
		lda tmphi
		ldy tmplo
		jmp getlastpage
		
+

		lda #maxDirY-1
		sta pos_cursor
		tya
		sec
		sbc #maxDirY-1
		tay			;y=valuelo
		txa
		sbc #0
					;a=valuehi
		
slsb_AX
		;lda valuehi
		;ldy valuelo

getlastpage
		jsr getreuadress		;see reu_numbers.tas - input A+X
		sta reu_datadr_lo
		stx reu_datadr_hi
		sty reu_datadr_bank
		jmp get_reu_dir			;i/o
		

get_random_16bit
;16 bit random over 0000-ffff by Whiteflame

		magic = $0053

		lda rseed
		beq lowZero	; $0000 and $8000 are special values to test for
 
 				; Do a normal shift
		asl rseed
		lda rseed+1
		rol
		bcc noEor
doEor				; high byte is in .A
		eor #>magic
		sta rseed+1
		lda rseed
		eor #<magic
		sta rseed
		rts
 
lowZero
		lda rseed+1
		beq doEor	; High byte is also zero, so apply the EOR
				; For speed, you could store 'magic' into 'seed' directly
				; instead of running the EORs
 
				; wasn't zero, check for $8000
		asl
		beq noEor	; if $00 is left after the shift, then it was $80
		bcs doEor	; else, do the EOR based on the carry bit as usual
 
noEor
		sta rseed+1
 		rts
rseed		.byte 0,0
;valuelo		.byte 0
;valuehi		.byte 0