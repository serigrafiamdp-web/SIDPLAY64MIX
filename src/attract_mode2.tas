;--------------------------------------------------------------
;Attract mode scroller, when selecting colors.
;--------------------------------------------------------------
;attract_mode

;---------- ZEROPAGES -----------------------------------------
scrl1				= $ff
;--------------------------------------------------------------



stmr		lda #$ff		;1-7f is stop scroller
		beq scroll
		dec stmr+1
		bne nscrl

scroll
		lda scrl1
		sec
spd		sbc #$01
		tax
		and #$07
		ora #$c8
		sta scrl1
		cpx scrl1
		bcs nscrl

		ldx #$00
sl1		lda screen2+1+(40*23)+1,x
		sta screen2++1+(40*23),x
		;lda #scroll_color
		;sta $d800+(screen&$03ff)+$01e0,x
		inx
		cpx #$26
		bne sl1
ok1
		inc fetch+1
		bne fetch
		inc fetch+2

fetch		lda text
		beq rst
		bpl go1
		ldx spd+1
		and #$07
		sta spd+1
		bne uff
		lda #$7f			;stop scroller for 127 frames
		sta stmr+1
		stx spd+1
		bne uff
rst		lda #<text
		ldx #>text
		sta fetch+1
		stx fetch+2
uff		lda #$20			;"Space"
go1		sta screen2+(40*23)+38

nscrl
		rts


text
.enc screen

;-----|123456789012345678901234567890123456789|
.if defset=1					;normal
.text " This version works best on serial disk "
.text "drives like the 1541, 1571, 1581 etc.  ",$80
 .if def_REU
.text "  A 512 kb REU allows you to have 4096 "
.text "filenames present in REU memory.",$80
 .else
.text " You can have 171 filenames in memory.",$80
 .fi
.text "Using a fastload cartridge such as the Action Replay, Retro Replay, TFC, Epyx Fastload etc. is  highly recommended. "
.fi ;defset1

;-----|123456789012345678901234567890123456789|
.if defset=2
.text " This is the ultimate sidplay64 version!",$80
.text " The 1541U-II with REU utilizing the command interface, it allows you to have "
.text "atleast 4096 filenames in memory.  And the file loading is instant! ",$80
.text " Thanks to Tom-Cat of Nostalgia for helping out implementing the 1541U2cmd routines. "
.text "Without him this version would have never seen the daylight.  "
.fi;defset2

;-----|123456789012345678901234567890123456789|
.if defset=3
.text " This version works best on *IEC* devices, but also IDE64(+ pclink), CMD FD, CMD HD, CMD Ramlink/Ramdrive. ",$80
.if def_REU
.text "  A 512 kb REU allows you to have 4096 "
.text "filenames present in REU memory.",$80
 .else
.text " You can have 171 filenames in memory.",$80
 .fi
.fi;defset3

;-----|123456789012345678901234567890123456789|
.if defset=4
.text " This is the SD2IEC version, it allows you to mount disk images like .d64 .d71 .d81 and .dnp ",$80
.if def_REU
.text "  A 512 kb REU allows you to have 4096 "
.text "filenames present in REU memory.",$80
 .else
.text " You can have 171 filenames in memory.",$80
 .fi
.fi;defset4

;-----|123456789012345678901234567890123456789|
.if defset=5
.text " The 1541U works best in iec/standalone mode. It can mount .d64 images and browse dirs. ",$80
.text "If you use The Final Replay together with Netdrive (on the pc) you can load sid files directly from your PC hard drive via your LAN. "
.if def_REU
.text "  A 512 kb REU allows you to have 4096 "
.text "filenames present in REU memory.",$80
 .else
.text "   You can have 171 filenames in memory.",$80
 .fi
.fi;defset5


;-----|123456789012345678901234567890123456789|
.text "       S : Toggles screen on/off.      ",$80
.text "          ",$1f," : Fast Forward.           ",$80
.text "     CBM : Exit Rsid's (if possible).  ",$80
.text "Both playlist modes (Play Next and Play Random) can be selected by pressing 'M'.  ",$80

;--------------------------------------------------------------
.text "  Support this tool by visiting : "
.text "https://sourceforge.net/projects/sidplay64/",$80,$80,$80
.text "                                      "
;--------------------------------------------------------------
.byte 0	;end byte for scroller
.enc none

