; TEST13 -- generic 19 PSID disk prefetch via Krill raw PSID loader.
; Original Glenn GUI, CIA TOD 00:05 prefetch, manual RETURN via Krill.
; TEST54: permit standard original PSID LOAD $2000-$2FFF when its
; entire body fits below $3000 (existing TEST44/45 page and byte
; alignment and overflow checks), preserving all TEST52 paths.
; TEST52: independent 9KB stage for unmodified PSIDs with LOAD $7A00-$7FFF;
; keep old 8KB bank, Krill $3C00, header and 199 previously tested SID.
; Input PSID first bytes 'PS' encode Krill load target $5350.
; Raw bytes 2+ appear at $5350; SID body begins $53CC.
; Keep TEST11 3 tunes VICE PASS frozen independently.
; TEST10 — KRILL LIVE SYMBIONT IN GLENN'S ORIGINAL PLAYER
; The driver reads INIT/PLAY from each original PSID header;
; LOAD remains $1000, music code/bank stays below $3000.
;
; $3000-$35FF: symbiont independent of Glenn's relocatable screen.
; $6000: Krill v184 installer, loaded AFTER Glenn has decompressed.
; $8800-$89FF: rebased Krill resident copied at PREPARE to $3C00-$3DEE.
; $9000-$9FFF: now available for music.
; TEST50: relocate resident Krill to $3C00-$3DEE; reclaim $9000-$9FFF for music.
; Keep all TEST48/47/46 classes and original SID bytes.
; 1541 protocol remains ordinary DOS until first real SID is KERNAL-loaded.
;
mix10_staged       .byte 0       ; DOS loads of Krill files complete
mix10_active       .byte 0       ; Krill owns 1541
mix10_ready        .byte 0       ; $5000 music bank validated
mix10_current      .byte 0       ; 0..maxfile-2: currently playing PSID index
mix10_pending      .byte 0       ; 0..maxfile-2: staged target index
mix10_filename     .fill 17,0   ; exact Glenn directory 16-char filename + NUL
mix10_savevalid    .byte 0
mix31_scan_idx     .byte 0  ; filename match index
mix10_loader_zp    .fill 22,0
mix10_music_zp     .fill 22,0
mix40_sid_count    .byte 0      ; dynamic number of playable entries (maxfile-1)

; All driver hooks reuse existing 3-byte JSR/JMP footprints to respect
; Glenn's strict relocator boundary ($CF84).
;
; Wrapper around original wjs_display; services Krill only after screen.
mix10_display
        jsr wjs_display
        jmp mix10_service

; Wrapper around original played SID INIT after normal load.
mix10_restart_wrap
        jsr mix10_activate
        jsr wjs_restartTune
        jmp mix10_after_restart

; Wrapper around Glenn original IRQ music play (zero-page protected).
mix10_music_play
        jsr mix10_music_enter
        jsr playmus
        jmp mix10_music_exit

; Wrapper around reset at Glenn's original playlist advance.
mix10_plt_reset
        jsr mix10_before_plt_advance
        jmp wjs_resetCia

; Wrapper dispatch for either original unmodified loader or RAM NEXT.
mix10_select
        lda mix10_active
        bne mix10_use_bank
        ldy #1
        jmp (wjp_load)
mix10_use_bank
        jmp mix10_fast_next

; Called AFTER Glenn's PuCrunch unpacking, initial options and colors,
; but BEFORE directory KERNAL reading and the first SID.
mix10_prepare
        ; TEST27: Krill binaries are already installed by PuCrunch into
        ; $6000 (installer) and $8800 (resident backup). DO NOT perform
        ; extra KERNAL disk reads during Glenn's startup.
        lda #0
        sta mix10_active
        sta mix10_ready
        sta mix10_current
        sta mix10_pending
        sta mix10_savevalid
        lda #1
        sta mix10_staged
        ; TEST29: trace bytes outside the current curated SID payload.
        ; Monitor in VICE: m $3ff0 $3ff7
        sta $3ff0                  ; $01: Krill payloads prepared
        lda #0
        sta $3ff1                  ; activation status
        sta $3ff2                  ; service/prefetch status
        sta $3ff3                  ; TOD seconds seen by service
        sta $3ff4                  ; current song index
        sta $3ff5                  ; pending song index
        sta $3ff6
        sta $3ff7
        sta $3ff8
        sta $3ff9
        sta $3ffa
        sta $3ffb
        sta $3ffc
        sta $3ffd
        sta $3ffe
        sta $3fff
        ; TEST50: Krill resident binary has been rebased to $3C00 at build time.
        ; Copy before KERNAL loads any SID, so $8800 may be overwritten.
        ldx #0
mix49_save_resident
        lda $8800,x
        sta $3c00,x
        lda $8900,x
        sta $3d00,x
        inx
        bne mix49_save_resident
        rts

; Called from Glenn original load code AFTER SID header and body
; both loaded and original main relocated, but BEFORE tune INIT.
mix10_activate
        ; TEST31: identify the actual loaded SID from its original name
        ; in fname ($0200) rather than assuming cursor index survived load.
        lda mix10_active
        beq mix31_activate_first
        lda #$20
        sta $3ff1
        rts
mix31_activate_first
        lda #$10
        sta $3ff1
        lda #$50                 ; PSID only in curated set
        cmp magicID
        bne mix31_bad_header
        lda #$53
        cmp magicID+1
        bne mix31_bad_header
        lda #$49
        cmp magicID+2
        bne mix31_bad_header
        lda #$44
        cmp magicID+3
        bne mix31_bad_header

        ; Source binary already contains Krill at $6000 and $8800:
        ; do not require a mutable staged flag.
        jsr mix31_find_loaded_index
        bcs mix31_not_found
        sta mix10_current
        sta $3ff4
        lda #$11
        sta $3ff1

        ; TEST50: Krill is already active at $3C00 from PREPARE.
        ; Never overwrite original SID music at $9000.
        sei
        lda #$36
        sta $01
        lda #8
        sta $ae
        sta $ba
        jsr $6000
        bcs mix10_activate_failed
        lda #$12
        sta $3ff1
        ldx #21
mix10_initial_save
        lda $c0,x
        sta mix10_loader_zp,x
        dex
        bpl mix10_initial_save
        lda #0
        sta mix10_ready
        sta mix10_pending
        sta mix10_savevalid
        lda #1
        sta mix10_active
        lda #6
        sta $d020
        rts

mix31_bad_header
        lda #$e5
        sta $3ff1
        rts
mix31_not_found
        lda #$e4
        sta $3ff1
        rts
mix10_activate_failed
        lda #$e0
        sta $3ff1
        lda #2
        sta $d020
        rts

; Scan SID rows 1..maxfile-1. SD2IEC folder must place the launch
; PRG at directory entry 0, then playable SID files. Match against
; the filename Glenn actually KERNAL-loaded (fname at $0200).
; Return A = 0..maxfile-2 and C clear; otherwise C set.
; IRQ disabled ONLY while banked-out directory name is compared.
mix31_find_loaded_index
        lda #1
        sta mix31_scan_idx
mix31_scan_loop
        lda mix31_scan_idx
        cmp maxfile
        bcs mix31_scan_fail
        tax
        jsr getpos              ; A=hi, Y=lo directory pointer
        sta $fc
        sty $fb
        php                      ; preserve caller IRQ state
        lda $01
        pha
        sei
        lda #$34               ; RAM under I/O for directory entries
        sta $01
        ldy #15
mix31_scan_compare
        lda ($fb),y
        cmp fname,y            ; raw filename saved by Glenn load routine
        bne mix31_scan_next
        dey
        bpl mix31_scan_compare
        pla
        sta $01
        plp
        lda mix31_scan_idx
        sta $3ff6              ; actual directory index, 1..19
        sec
        sbc #1
        clc
        rts
mix31_scan_next
        pla
        sta $01
        plp
        inc mix31_scan_idx
        jmp mix31_scan_loop
mix31_scan_fail
        sec
        rts


; Original Glenn restartTune calls CIA reset (clears ZP $0C-$FF),
; then invokes music INIT. Restore the loader's private ZP afterwards.
mix10_after_restart
        lda mix10_active
        beq mix10_ar_done
        sei
        ldx #21
mix10_ar_loop
        lda $c0,x
        sta mix10_music_zp,x
        lda mix10_loader_zp,x
        sta $c0,x
        dex
        bpl mix10_ar_loop
        lda #1
        sta mix10_savevalid
        cli
mix10_ar_done
        rts

; Extend Glenn's IRQ zero page switching from 02-08 to $C0-$D5.
; Must not affect original music tempo: no CIA timer modifications.
mix10_music_enter
        lda mix10_active
        beq mix10_music_in_done
        lda mix10_savevalid
        beq mix10_music_in_done
        ldx #21
mix10_music_in_loop
        lda $c0,x
        sta mix10_loader_zp,x
        lda mix10_music_zp,x
        sta $c0,x
        dex
        bpl mix10_music_in_loop
mix10_music_in_done
        rts

mix10_music_exit
        lda mix10_active
        beq mix10_music_out_done
        lda mix10_savevalid
        beq mix10_music_out_done
        ldx #21
mix10_music_out_loop
        lda $c0,x
        sta mix10_music_zp,x
        lda mix10_loader_zp,x
        sta $c0,x
        dex
        bpl mix10_music_out_loop
mix10_music_out_done
        rts

; MASTER TEST19 PASS (27-Oct-2026)
; Always prefetch while a SID is playing, in Manual or Next mode.
; Start at 00:05 by reading CIA TOD seconds ($DC09, BCD 05);
; DO NOT CHANGE Glenn's song-end/next-playlist timer.
; This follows the two-byte patch verified in the TEST19 D64.
; Single PRG in directory position 0, followed by SID files.
; TEST39 SD2IEC loose-file mode: up to Glenn's maxentries-1 SID entries.
; Original Glenn IRQ keeps SID audio alive.
mix10_service
        ; Inspect the real states even when no precache attempt occurs.
        lda pos_cursor
        sta $3ff8
        lda offs_cursor
        sta $3ff9
        lda maxfile
        sta $3ffa
        lda mix10_staged
        sta $3ffb
        lda mix10_active
        sta $3ffc
        lda mix10_ready
        sta $3ffd
        lda $dc09
        sta $3ff3                  ; most recent TOD seconds
        lda mix10_active
        beq mix10_service_done
        lda mix10_ready
        bne mix10_service_done
        lda $dc09             ; TOD seconds (BCD), not minute
        cmp #$05              ; start prefetch at 00:05
        bcc mix10_service_done
        lda #$03
        sta $3ff2                  ; five-second path reached
        ; TEST40: directory entry 0 is the player, music entries
        ; are 1..maxfile-1. NEVER compare with a hardcoded 19.
        ; Determine modulo dynamically, even after manual ENTER on
        ; an arbitrary high directory index.
        lda maxfile
        cmp #2                     ; no music available
        bcc mix10_service_done
        sec
        sbc #1
        sta mix40_sid_count        ; count of playable SID files

        lda mix10_current         ; 0-based actual SID index
        clc
        adc #1
        cmp mix40_sid_count
        bcc mix10_service_target_ok
        lda #0                    ; wrap ONLY after the actual last SID
mix10_service_target_ok
        sta mix10_pending
        sta $3ff5                  ; song being prefetched
        jsr mix10_stage_pending
        bcs mix10_service_failed
        lda #1
        sta mix10_ready
        lda #4
        sta $3ff2                  ; successful prefetch
        lda #5
        sta $d020
mix10_service_done
        rts
mix10_service_failed
        lda #$ff
        sta $3ff2                  ; failed prefetch / validation
        lda #2
        sta mix10_ready
        sta $d020
        rts

; Manual RETURN, intercepted at the original Glenn key dispatcher.
; Before Krill is installed follow EXACT original Glenn RESET+LOAD.
; After Krill takeover do not call KERNAL. Stage the selected PSID,
; then hand off through Glenn's own restartTune and timer.
mix10_manual_select
        lda mix10_active
        bne mix10_manual_active
        jsr wjs_resetCia
        jmp (wjp_load)
mix10_manual_active
        lda offs_cursor
        clc
        adc pos_cursor
        beq mix10_manual_exit
        ; TEST39: Glenn read up to maxentries, no fixed 19-song cap.
        cmp maxfile
        bcs mix10_manual_exit
        sec
        sbc #1
        sta mix10_pending
        lda #0
        sta mix10_ready
        jsr mix10_stage_pending
        bcs mix10_manual_fail
        lda #1
        sta mix10_ready
        jmp mix10_fast_next
mix10_manual_fail
        lda #2
        sta mix10_ready
        sta $d020
mix10_manual_exit
        jmp (wjp_fileselect)

; Read one filename from original Glenn directory RAM under I/O.
; Directory: entry 0 launcher PRG; entries 1..maxfile-1 are SID files.
; Bounded 16 chars, preserve embedded spaces, strip trailing padding.
mix10_make_filename
        ; TEST34: code for getpos and the directory both live in RAM
        ; under $D000 I/O. Bank before calling getpos, not afterwards.
        php                        ; preserve caller IRQ state
        sei
        lda $01
        pha
        lda #$34                   ; all RAM, including $D000-$DFFF
        sta $01
        lda #$21
        sta $3ff7                  ; banked RAM selected, getpos next
        lda mix10_pending
        clc
        adc #1
        tax
        jsr getpos
        sta $fc
        sty $fb
        lda #$22
        sta $3ff7                  ; getpos returned correct pointer
        ldy #15
mix10_cp_name
        lda ($fb),y
        sta mix10_filename,y
        dey
        bpl mix10_cp_name
        lda #$23
        sta $3ff7                  ; name copied from directory RAM
        pla
        sta $01                    ; restore original C64 memory mapping
        plp                        ; restore caller interrupt flag
        ldx #15
mix10_trim_name
        lda mix10_filename,x
        cmp #$20
        beq mix10_trim_byte
        cmp #$a0
        beq mix10_trim_byte
        inx
        lda #0
        sta mix10_filename,x
        rts
mix10_trim_byte
        dex
        bpl mix10_trim_name
        lda #0
        sta mix10_filename
        rts

; Krill raw load an original PSID, not extra pre-converted MIX_x files.
; File begins ASCII PSID, so Krill PRG loader interprets $5350 as
; address from first two bytes 'P','S'. Remaining header goes at $5350.
; Off $7C and load-address WORD $1000 => music body at $53CC.
; TEST41: Stage 32 pages at $5000-$6FFF; accepts <=8192 bytes from LOAD=$1000.
; TEST41 shipping build: publish 00PLAYER.PRG alongside original SID folder (no SID rewrites).
; Clear scratch $5300-$73FF BEFORE loading so tail zero padding is safe.
mix10_stage_pending
        lda #$10
        sta $3ff7                 ; stage was entered
        jsr mix10_make_filename
        lda #$20
        sta $3ff7                 ; filename returned
        lda #7
        sta $d020
        ; TEST52: no long SEI section here. 37 x 256 bytes cleared
        ; with absolute indexed addressing, which uses NO zero-page
        ; pointers that SID IRQs might overwrite. Do not stop music.
        ; Scratch $5300-$77FF is below supported new tune LOAD $7A00.
        lda #$53
        sta mix10_zero_byte+2     ; reset self-modifying STA $5300,Y
        ldx #37
mix10_zero_page
        ldy #0
        lda #0
mix10_zero_byte
        sta $5300,y
        iny
        bne mix10_zero_byte
        inc mix10_zero_byte+2
        dex
        bne mix10_zero_page

        lda #$30
        sta $3ff7                 ; scratch cleared; IRQs stayed enabled
        lda #$40
        sta $3ff7                 ; about to call Krill
        lda #0                    ; preserve original loader A input
        ldx #<mix10_filename
        ldy #>mix10_filename
        jsr $3c00                  ; relocated Krill, IRQ SID playback
        php
        lda #$50
        sta $3ff7                 ; Krill returned
        plp
        bcc mix44_krill_ok
        jmp mix10_stage_bad
mix44_krill_ok

        ; Validate original PSID header, load and safe dynamic INIT/PLAY vectors.
        ; PSID bytes [2]='I',[3]='D' land at 5350/5351.
        lda $5350
        cmp #$49
        bne mix46_early_bad
        lda $5351
        cmp #$44
        bne mix46_early_bad
        lda $5354                  ; big endian data offset $007C
        bne mix46_early_bad
        lda $5355
        cmp #$7c
        bne mix46_early_bad
        lda $5356                  ; big endian load address $0000
        ora $5357
        bne mix46_early_bad
        jmp mix46_early_ok
mix46_early_bad
        jmp mix44_bad_header
mix46_early_ok
        lda #0
        sta mix52_long
        sta mix49_8000
        sta mix48_basic
        ; TEST47: music in RAM under KERNAL ROM, but never over the
        ; Glenn character font at $F800-$FFFF.  Stage only into $5000;
        ; the exact original PSID bytes are committed to $E000 on NEXT.
        ; The active presentation must have relocated its font to $F800.
        lda #0
        sta mix47_high
        lda $53ca                  ; embedded original load low byte
        bne mix47_not_e000
        lda $53cb
        cmp #$e0
        bne mix47_not_e000
        lda fontpos
        cmp #$f8                   ; viewport font must be at $F800
        bne mix47_bad_high
        lda $5358                  ; original INIT must be within safe $E000-$F7FF
        cmp #$e0
        bcc mix47_bad_high
        cmp #$f8
        bcs mix47_bad_high
        lda $535a                  ; PLAY in safe high-memory window
        cmp #$e0
        bcc mix47_bad_high
        cmp #$f8
        bcs mix47_bad_high
        lda #1
        sta mix47_high
        lda #0
        sta mix46_is_low
        jmp mix44_header_ok
mix47_bad_high
        jmp mix44_bad_header
mix47_not_e000
        ; TEST52: long original SID class, LOAD in $7A00-$7FFF
        ; and INIT/PLAY below $A000 (never Glenn main or resident).
        ; Raw PSID payload is staged $4000-$63FF (9KB), then copied
        ; unshifted to the exact original LOAD at NEXT.
        lda $53cb
        cmp #$7a
        bcc mix52_not_long
        cmp #$80
        bcs mix52_not_long
        sta mix52_load_hi
        lda $53ca
        sta mix52_load_lo
        lda $5358
        cmp mix52_load_hi
        bcc mix52_bad_long
        cmp #$a0
        bcs mix52_bad_long
        lda $535a
        cmp mix52_load_hi
        bcc mix52_bad_long
        cmp #$a0
        bcs mix52_bad_long
        lda $5358
        cmp mix52_load_hi
        bne mix52_init_ok
        lda $5359
        cmp mix52_load_lo
        bcc mix52_bad_long
mix52_init_ok
        lda $535a
        cmp mix52_load_hi
        bne mix52_play_ok
        lda $535b
        cmp mix52_load_lo
        bcc mix52_bad_long
mix52_play_ok
        lda #1
        sta mix52_long
        jmp mix44_header_ok
mix52_bad_long
        jmp mix44_bad_header
mix52_not_long
        ; TEST48: new independent class, original PSID embedded LOAD
        ; anywhere in $A000-$BFFF (including offset within a page).
        ; Existing TEST44/45 staged-bank shift supports this unchanged
        ; after mapping $A0 onto virtual $10 (subtract $90).
        lda $53cb
        cmp #$a0
        bcc mix48_not_basic
        cmp #$c0
        bcs mix48_not_basic
        sta mix48_real_load_hi
        lda $53ca
        sta mix45_load_lo
        ; INIT and PLAY must be within actual original BASIC-RAM zone
        ; and must not precede the source LOAD page.
        lda $5358
        cmp mix48_real_load_hi
        bcc mix48_bad_basic
        cmp #$c0
        bcs mix48_bad_basic
        lda $535a
        cmp mix48_real_load_hi
        bcc mix48_bad_basic
        cmp #$c0
        bcs mix48_bad_basic
        ; If same LOAD page, require vector low byte >= LOAD low byte.
        lda $5358
        cmp mix48_real_load_hi
        bne mix48_init_ok
        lda $5359
        cmp mix45_load_lo
        bcc mix48_bad_basic
mix48_init_ok
        lda $535a
        cmp mix48_real_load_hi
        bne mix48_play_ok
        lda $535b
        cmp mix45_load_lo
        bcc mix48_bad_basic
mix48_play_ok
        lda mix48_real_load_hi
        sec
        sbc #$90                ; virtual LOAD high $10..$2F
        sta mix44_load_hi
        lda #0
        sta mix46_is_low
        lda #1
        sta mix48_basic
        jmp mix44_header_ok
mix48_bad_basic
        jmp mix44_bad_header
mix48_not_basic
        ; TEST50: full $8000-$9FFF class, because active Krill moved
        ; to $3C00. Music is original, LOAD may be byte-unaligned.
        lda $53cb
        cmp #$80
        bcc mix49_not_8000
        cmp #$a0
        bcs mix49_not_8000
        sta mix49_real_load_hi
        lda $53ca
        sta mix45_load_lo
        lda $5358
        cmp mix49_real_load_hi
        bcc mix49_bad_8000
        cmp #$a0
        bcs mix49_bad_8000
        lda $535a
        cmp mix49_real_load_hi
        bcc mix49_bad_8000
        cmp #$a0
        bcs mix49_bad_8000
        lda $5358
        cmp mix49_real_load_hi
        bne mix49_init_ok
        lda $5359
        cmp mix45_load_lo
        bcc mix49_bad_8000
mix49_init_ok
        lda $535a
        cmp mix49_real_load_hi
        bne mix49_play_ok
        lda $535b
        cmp mix45_load_lo
        bcc mix49_bad_8000
mix49_play_ok
        lda mix49_real_load_hi
        sec
        sbc #$70                   ; virtual $80 -> $10, $9f -> $2f
        sta mix44_load_hi
        lda #0
        sta mix46_is_low
        lda #1
        sta mix49_8000
        jmp mix44_header_ok
mix49_bad_8000
        jmp mix44_bad_header
mix49_not_8000
        ; TEST46: allow special LOAD=$0FFF (exact 1 byte below $1000),
        ; or arbitrary original LOAD $1000-$1FFF. Stage normalized at $1000
        ; before committing and still copied unchanged at playback.
        ; Original PSID INIT/PLAY are restored by mix37_commit_metadata.
        ; Reject self-IRQ PLAY=0 or vectors outside bank $1000-$2FFF.
        ; Single-byte exception: LOAD/INIT=$0FFF, valid PLAY $1000-$2FFF.
        lda $53ca
        cmp #$ff
        bne mix46_regular_load
        lda $53cb
        cmp #$0f
        bne mix44_bad_header
        lda $5358
        cmp #$0f
        bne mix44_bad_header
        lda $5359
        cmp #$ff
        bne mix44_bad_header
        lda $535a
        cmp #$10
        bcc mix44_bad_header
        cmp #$30
        bcs mix44_bad_header
        lda #1
        sta mix46_is_low
        lda #$10
        sta mix44_load_hi
        lda #0
        sta mix45_load_lo
        jmp mix44_header_ok
mix46_regular_load
        lda #0
        sta mix46_is_low
        lda $5358                  ; big-endian INIT high byte
        cmp #$10
        bcc mix44_bad_header
        cmp #$30
        bcs mix44_bad_header
        lda $535a                  ; big-endian PLAY high byte
        cmp #$10
        bcc mix44_bad_header
        cmp #$30
        bcs mix44_bad_header
        lda $53ca                  ; TEST45: preserve any original LOAD low byte
        sta mix45_load_lo
        lda $53cb                  ; high byte $10..$2f inclusive
        cmp #$10
        bcc mix44_bad_header
        cmp #$30                  ; TEST54 extends original LOAD to $2000-$2FFF
        bcs mix44_bad_header
        sta mix44_load_hi          ; record before copy overwrites PSID header
        ; Keep INIT/PLAY from falling below the declared LOAD page.
        lda $5358
        cmp mix44_load_hi
        bcc mix44_bad_header
        lda $535a
        cmp mix44_load_hi
        bcc mix44_bad_header

        jmp mix44_header_ok
mix44_bad_header
        jmp mix10_stage_bad
mix44_header_ok
        ; TEST37: capture original 124-byte PSID header before the
        ; following 26-page copy overwrites $5350-$53CB.
        jsr mix37_capture_header
        lda mix52_long
        beq mix52_regular_stage
        ; TEST52: copy 36 pages source $53CC..$77CB into stage
        ; $4000..$63FF.  Destination stays BELOW source, so forward
        ; copy is safe even with the source/destination overlapping.
        ; Source tail was zeroed at $5300-$77FF before Krill load.
        lda #$cc
        sta mix52_source+1
        lda #$53
        sta mix52_source+2
        lda #$40
        sta mix52_store+2
        ldx #$24
mix52_copy_page
        ldy #0
mix52_source
        lda $53cc,y
mix52_store
        sta $4000,y
        iny
        bne mix52_source
        inc mix52_source+2
        inc mix52_store+2
        dex
        bne mix52_copy_page
        lda #$62
        sta $3ff7
        clc
        rts
mix52_regular_stage

        ; TEST35: use self-modifying absolute,Y accesses in place
        ; of $FB-$FE indirect ZP, permitting the active SID IRQ to run.
        ; TEST46: for LOAD=$0FFF, save byte 0 from the original SID.
        ; The remaining 8191 bytes begin at $53CD and belong at $1000.
        ; For every other LOAD, preserve TEST45's original $53CC source.
        lda #$cc
        ldx mix46_is_low
        beq mix46_copy_source_ready
        lda $53cc
        sta mix46_first_byte
        lda #$cd
mix46_copy_source_ready
        sta mix10_stage_cp_byte+1
        lda #$53
        sta mix10_stage_cp_byte+2
        lda #$50
        sta mix10_stage_store+2
        ldx #$20
mix10_stage_cp_page
        ldy #0
mix10_stage_cp_byte
        lda $53cc,y
mix10_stage_store
        sta $5000,y
        iny
        bne mix10_stage_cp_byte
        inc mix10_stage_cp_byte+2
        inc mix10_stage_store+2
        dex
        bne mix10_stage_cp_page
        ; TEST47: high $E000 music uses the original unshifted body at
        ; $5000 and may occupy only the first 24 pages (6144 bytes).
        ; If any later staged byte is nonzero, reject instead of drawing
        ; over the font at $F800.
        lda mix47_high
        beq mix47_low_stage
        jsr mix47_check_tail
        bcs mix10_stage_bad
        jmp mix47_stage_done
mix47_low_stage
        ; Legacy TEST44-TEST46 8KB transfer: same validated code path.
        jsr mix44_align_staging
        bcs mix10_stage_bad
        jsr mix45_shift_low
        bcs mix10_stage_bad
        ; TEST50: $9000 is now free. Existing TEST44/45 overflow checks
        ; enforce the full $8000-$9FFF 8KB destination.
mix47_stage_done
        lda #$60
        sta $3ff7                 ; PSID staging finished
        clc
        rts
mix10_stage_bad
        lda #$e0
        sta $3ff7                 ; failed header / loader
        sec
        rts

; TEST44: relocate the STAGING IMAGE, never original SID bytes.
; Krill has placed the original music body at $53CC, and TEST43
; has copied it to $5000-$6FFF.  For LOAD=$1800, e.g., shift
; pages $5000-$67FF to $5800-$6FFF and clear $5000-$57FF.
; The existing TEST41 handoff still copies exactly 8KB to $1000.
; Since the destination is above the source, all shifting is done
; BACKWARDS; IRQ remains enabled and ZP is untouched.
mix44_align_staging
        lda mix44_load_hi
        sec
        sbc #$10
        sta mix44_offset_pages
        bne mix44_align_needed
        clc                        ; LOAD=$1000 is bit-identical to TEST43
        rts
mix44_align_needed
        lda #$30
        sec
        sbc mix44_load_hi
        sta mix44_copy_pages       ; maximum whole pages below $3000
        clc
        adc #$50
        sta mix44_scan_byte+2      ; start of would-be overflow area
        ldx mix44_offset_pages
mix44_scan_page
        ldy #0
mix44_scan_each
mix44_scan_byte
        lda $6000,y
        beq mix44_scan_zero
        sec                        ; nonzero beyond safe destination: reject
        rts
mix44_scan_zero
        iny
        bne mix44_scan_each
        inc mix44_scan_byte+2
        dex
        bne mix44_scan_page

        lda mix44_copy_pages
        clc
        adc #$4f
        sta mix44_shift_read+2
        lda #$6f
        sta mix44_shift_write+2
        ldx mix44_copy_pages
mix44_shift_page
        ldy #$ff
mix44_shift_each
mix44_shift_read
        lda $5000,y
mix44_shift_write
        sta $5000,y
        dey
        cpy #$ff
        bne mix44_shift_each
        dec mix44_shift_read+2
        dec mix44_shift_write+2
        dex
        bne mix44_shift_page

        lda #$50
        sta mix44_clear_byte+2
        ldx mix44_offset_pages
mix44_clear_page
        ldy #0
        lda #0
mix44_clear_byte
        sta $5000,y
        iny
        bne mix44_clear_byte
        inc mix44_clear_byte+2
        dex
        bne mix44_clear_page
        clc
        rts

mix44_load_hi       .byte $10
mix44_offset_pages  .byte 0
mix44_copy_pages    .byte 0

; TEST45: finish relocation of the STAGED bank by the low byte of
; the original LOAD address.  TEST44 has already shifted whole pages.
; Verify that no nonzero bytes would fall above music range $2FFF.
; Copy backwards with absolute indexed addressing while music IRQs run;
; avoid any $FB-$FE / Krill zero-page changes during the stage.
mix45_shift_low
        lda mix45_load_lo
        bne mix45_needed
        clc                        ; page-aligned music: exactly TEST44
        rts
mix45_needed
        lda #0
        sec
        sbc mix45_load_lo
        tay                        ; first byte of the final LOAD-low tail
mix45_tail_check
        lda $6f00,y
        bne mix45_overflow
        iny
        bne mix45_tail_check

        lda #$6f
        sta mix45_read_byte+2
        sta mix45_write_byte+2
        lda mix45_load_lo
        sta mix45_write_byte+1
        ldx #$20                   ; 32 pages, last to first
mix45_shift_page
        ldy #$ff
mix45_shift_each
mix45_read_byte
        lda $6f00,y
mix45_write_byte
        sta $6f00,y
        dey
        cpy #$ff
        bne mix45_shift_each
        dec mix45_read_byte+2
        dec mix45_write_byte+2
        dex
        bne mix45_shift_page

        ldy #0
        ldx mix45_load_lo
        lda #0
mix45_clear_prefix
        sta $5000,y
        iny
        dex
        bne mix45_clear_prefix
        clc
        rts
mix45_overflow
        sec
        rts

mix45_load_lo        .byte 0
mix52_long           .byte 0  ; 1: 9KB load to real $7A00-$7FFF
mix52_load_lo        .byte 0
mix52_load_hi        .byte 0
; TEST50: full 8KB $8000-$9FFF, no 4KB tail scan.
mix49_8000          .byte 0
mix49_real_load_hi  .byte 0
mix48_basic          .byte 0  ; 1= original LOAD $A000-$BFFF
mix48_real_load_hi   .byte 0  ; actual high byte before virtual remap
; TEST47: staged 8KB bank is $5000-$6FFF; the high memory destination
; is $E000-$F7FF. Test all bytes $6800-$6FFF before touching RAM.
mix47_check_tail
        lda #$68
        sta mix47_tail_byte+2
        ldx #8
mix47_tail_page
        ldy #0
mix47_tail_loop
mix47_tail_byte
        lda $6800,y
        bne mix47_tail_bad
        iny
        bne mix47_tail_loop
        inc mix47_tail_byte+2
        dex
        bne mix47_tail_page
        clc
        rts
mix47_tail_bad
        sec
        rts
mix47_high           .byte 0
mix46_is_low         .byte 0     ; 1 only for original LOAD=$0FFF, INIT=$0FFF
mix46_first_byte     .byte 0     ; literal original SID code byte at $0FFF

; Called before Glenn clears $0C-$FF at playlist auto-advance.
mix10_before_plt_advance
        lda mix10_active
        beq mix10_bpa_done
        ldx #21
mix10_bpa_loop
        lda $c0,x
        sta mix10_loader_zp,x
        dex
        bpl mix10_bpa_loop
mix10_bpa_done
        rts

; Glenn has already advanced the directory cursor and used its
; original timer. Music LOAD is $1000, but INIT/PLAY can differ by SID;
; copy the ready payload in RAM, patch Glenn's jump vectors from its
; ORIGINAL PSID header, then reuse its IRQ, timer and screen.
mix10_fast_next
        lda mix10_ready
        cmp #1
        beq mix46_ready_now
        jmp mix10_no_ready
mix46_ready_now
        sei
        lda #0
        sta $dc0e
        lda #$7f
        sta $dc0d
        lda $dc0d
        lda #0
        sta $d418
        sta mix10_ready

        lda #$00
        sta $fb                  ; source offset 0 from staging $5000
        sta $fd                  ; destination offset 0 (either $1000 or $E000)
        lda #$50
        sta $fc
        lda mix52_long
        beq mix52_regular_handoff
        ; TEST52 direct 9KB transfer, copy EXACT original load address.
        lda #$40
        sta $fc
        lda mix52_load_lo
        sta $fd
        lda mix52_load_hi
        sta $fe
        ldx #$24
        jmp mix10_cp_page
mix52_regular_handoff
        lda mix47_high
        beq mix47_low_handoff
        lda #$35
        sta $01                  ; RAM under KERNAL, I/O visible
        lda #$e0
        sta $fe                  ; exact high destination $E000
        ldx #$18                 ; 24 pages only, font $F800 untouched
        jmp mix10_cp_page
mix47_low_handoff
        lda mix48_basic
        beq mix48_low_handoff
        lda #$35
        sta $01                  ; BASIC ROM disabled, I/O remains available
        lda #$a0
        sta $fe                  ; $A000-$BFFF RAM, byte-aligned staging
        ldx #$20
        jmp mix10_cp_page
mix48_low_handoff
        lda mix49_8000
        beq mix49_low_handoff
        lda #$80
        sta $fe                  ; original $8000-$9FFF bank
        ldx #$20                 ; 32 pages, Krill safe at $3C00
        jmp mix10_cp_page
mix49_low_handoff
        lda #$10
        sta $fe
        ldx #$20                 ; TEST46 path: full 32 pages to $1000
mix10_cp_page
        ldy #0
mix10_cp_byte
        lda ($fb),y
        sta ($fd),y
        iny
        bne mix10_cp_byte
        inc $fc
        inc $fe
        dex
        bne mix10_cp_page

        ; Special $0FFF entry point: restore the ORIGINAL first code byte
        ; immediately before updating Glenn's vectors and invoking INIT.
        ; IRQs are disabled during this short commit as in TEST45.
        lda mix46_is_low
        beq mix46_handoff_normal
        lda mix46_first_byte
        sta $0fff
mix46_handoff_normal

        ; Adopt the exact chosen/prefetched song, not an internal
        ; A/B/C counter disconnected from Glenn's directory.
        lda mix10_pending
        sta mix10_current
        sta $3ff4                   ; TEST35: real currently playing song, not stale trace
        lda #0
        sta $3ff2                   ; reset old prefetch state for next 5-second cycle
        lda mix10_current
        clc
        adc #1                     ; Glenn list includes SIDPLAY64MIX at index 0
        cmp #15
        bcs mix10_scroll_down
        sta pos_cursor
        lda #0
        sta offs_cursor
        jmp mix10_display_synced
mix10_scroll_down
        sec
        sbc #14
        sta offs_cursor
        lda #14
        sta pos_cursor
mix10_display_synced
        ; TEST37: refresh Glenn's cover and metadata from the staged PSID.
        ; This runs at song transition, not during prefetch; no disk read.
        jsr mix37_commit_metadata
        ; Krill's loader ZP must survive Glenn restartTune's CIA reset.
        ldx #21
mix10_commit_loader_zp
        lda $c0,x
        sta mix10_loader_zp,x
        dex
        bpl mix10_commit_loader_zp
        lda #$35
        sta $01
        jsr wjs_restartTune     ; same Glenn INIT/PLAY and timer
        jsr mix10_after_restart ; restore loader zp
        jmp (wjp_fileselect)

mix10_no_ready
        ; Stage not ready. No drive access, no forced old-KERNAL LOAD.
        ; Return to Glenn UI and let service continue only if incomplete.
        jmp (wjp_fileselect)

; TEST37 -- Original file bytes 00-7B are cached in RAM at $3E00.
; Krill treats the leading "PS" as a PRG load word and begins placing
; bytes at file offset +2 into $5350. Cache the header before copying
; music bytes to $5000, which would overwrite the staging buffer.
mix37_capture_header
        lda #$50
        sta mix37_header_cache
        lda #$53
        sta mix37_header_cache+1
        ldx #0
mix37_capture_loop
        lda $5350,x
        sta mix37_header_cache+2,x
        inx
        cpx #$7a
        bne mix37_capture_loop

        ; TEST38: original Glenn load-iec-serial.tas/getheada converts
        ; ONLY header text bytes offsets $16..$75:
        ; null -> $20, ASCII >= $60 -> (byte & $1F).
        ; PSID header on disk is ASCII with null padding; copying it
        ; straight to C64 video RAM displayed @/garbage after names.
        ldy #$75
mix38_normalize_text
        lda mix37_header_cache,y
        bne mix38_nonzero
        lda #$20
        bne mix38_normalized
mix38_nonzero
        cmp #$60
        bcc mix38_normalized
        and #$1f
mix38_normalized
        sta mix37_header_cache,y
        dey
        cpy #$15
        bne mix38_normalize_text

        lda #$71
        sta $3ffe                 ; header cached before music bank copy
        rts

; Refresh the same screen fields as doheaderstuff, but do NOT invoke
; doheaderstuff: that routine also relocates code and stack-jumps.
; Called with IRQs disabled at the safe change-song boundary.
mix37_commit_metadata
        ; TEST43: dynamic Glenn INIT / PLAY vectors (original PSID big-endian fields).
        lda mix37_header_cache+$0b
        sta initMus+1
        lda mix37_header_cache+$0a
        sta initMus+2
        lda mix37_header_cache+$0d
        sta playMus+1
        lda mix37_header_cache+$0c
        sta playMus+2

        ; Glenn's subtune list and speed flags belong to new PSID.
        lda mix37_header_cache+$0f
        sec
        sbc #1
        sta maxtune
        lda mix37_header_cache+$11
        sec
        sbc #1
        sta tune
        ldx #3
mix37_speed_copy
        lda mix37_header_cache+$12,x
        sta speedtimer,x
        dex
        bpl mix37_speed_copy

        lda mix37_header_cache+$77
        and #$0c
        lsr
        lsr
        sta tunesystem

        ; UI strings and printhexnum live at $D000 in RAM under IO.
        ; Bank all RAM only during this short, transition-time paint.
        lda $01
        pha
        lda #$34
        sta $01
        lda #$80                  ; title base at $0480 / $C480
        sta gzp
        lda screenpos
        sta gzp+1
        ldy #30
mix37_title_loop
        lda mix37_header_cache+$16,y
        sta (gzp),y
        dey
        bpl mix37_title_loop

        ldx #30
        ldy #70
mix37_author_loop
        lda mix37_header_cache+$36,x
        sta (gzp),y
        dey
        dex
        bpl mix37_author_loop

        ldx #30
        ldy #110
mix37_release_loop
        lda mix37_header_cache+$56,x
        sta (gzp),y
        dey
        dex
        bpl mix37_release_loop

        ; SID 6581 / 8580 model label from the original Glenn table.
        lda mix37_header_cache+$77
        and #$30
        lsr
        lsr
        tax
        ldy #160
mix37_chip_loop
        lda chiptype,x
        sta (gzp),y
        inx
        iny
        cpy #164
        bne mix37_chip_loop

        ; PAL / NTSC label from the original Glenn table.
        lda mix37_header_cache+$77
        and #$0c
        tax
        ldy #200
mix37_system_loop
        lda system,x
        sta (gzp),y
        inx
        iny
        cpy #204
        bne mix37_system_loop

        ; INIT / PLAY address numbers, same coordinates as Glenn's
        ; original doheaderstuff routine.
        ldy #243
        lda mix37_header_cache+$0b
        jsr printhexnum
        lda mix37_header_cache+$0a
        jsr printhexnum
        inc gzp+1
        ldy #27
        lda mix37_header_cache+$0d
        jsr printhexnum
        lda mix37_header_cache+$0c
        jsr printhexnum

        ; Update the current PSID filename on the cover.
        ; The filename already lives in mix10_filename from the Krill
        ; stage, but TEST37 only refreshed the song title underneath it.
        ; Same $042E/$C42E address + convert_letter as the original
        ; Glenn src/load-iec-serial.tas / loadfile logic.
        lda #$2e
        sta gzp
        lda screenpos
        sta gzp+1
        ldy #15
mix38_filename_loop
        lda mix10_filename,y
        beq mix38_filename_space
        cmp #$a0
        bne mix38_filename_convert
mix38_filename_space
        lda #$20
mix38_filename_convert
        jsr convert_letter
        sta (gzp),y
        dey
        bpl mix38_filename_loop

        pla
        sta $01                   ; leave C64 memory mapping intact
        lda #$72
        sta $3fff                 ; new song metadata rendered
        rts

mix10_insta      .byte $49,$4e,$53,$54,$41
mix10_insta_end
mix10_resident   .byte $52,$45,$53,$49,$44,$45,$4e,$54
mix10_resident_end
