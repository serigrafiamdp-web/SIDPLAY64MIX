;--------------------------------------------------------------
;	REU Input/Output
;--------------------------------------------------------------
; * Part of relocatable main:
;--------------------------------------------------------------
; only called by static routines in ram d000-e000 using the stack
; jump table.
;
; check "get_reu_dir" & "write_reu_dir_entry" in d000-e000
;
;zp $01 is always 38 or 34 when caling this :

;wjs_exe_reucomm - execute_reu_command 



		
;		ldy #10			;this part is now at d000-e000
;-		lda reu_comm-1,y
;		pha
;		dey
;		bne -
;		ldx $01			;38/34 ?
;		lda #$35		;35
		
		sta $01			;35
-		pla
		sta REU_command,y
		iny
		cpy #10
		bne -
		dec $01			;34 - all RAM available
		lda $ff00		;Read and ...
		sta $ff00		;.. write to execute DMA transfer
		inc $01			;35
		lda REU_status
		stx $01			;38/34 ?
		
					;CARRY flag is set with cpy #10 above
		rts			;note: the PLT function needs the carry flag to be set. 

		
.comment
.if def_reu512
                lda reu_datadr_bank
                tax
                and #7
                cmp #7                  ;check if bank is close to a 512kb wrap position
                bne +
                lda #0
                sta reu_datadr_lo
                sta reu_datadr_hi
                inx
                stx reu_datadr_bank     ;08,10,18,20,28.... F8
+               
.fi
.endc
