;--------------------------------------------------------------
;	REU Input/Output
;--------------------------------------------------------------
; * Part of relocatable main:
;--------------------------------------------------------------
; only called by static routines in ram d000-e000 using the stack
; jump table.
;
; check "get_reu_dir" & "write_reu_dir_entry" in d000-e000
;

;execute_reu_command

		ldx #10
-		lda reu_comm-1,x
		pha
		dex
		bne -
		
		lda #$36
		sta $01

-		pla
		sta REU_command,x
		inx
		cpx #10
		bne -

		ldx #$38
		stx $01			;38	;all RAM available
		lda $ff00			;Read and ...
		sta $ff00			;.. write to execute DMA transfer
		lda #$36
		sta $01			;36
		lda REU_status
		stx $01			;38
		rts

		
.comment
.if def_reu512
                lda reu_datadr_bank
                tax
                and #7
                cmp #7                  ;check if bank is close to a 512kb wrap position
                bne +
                lda #0
                sta reu_datadr_lo
                sta reu_datadr_hi
                inx
                stx reu_datadr_bank     ;08,10,18,20,28.... F8
+               
.fi
.endc


