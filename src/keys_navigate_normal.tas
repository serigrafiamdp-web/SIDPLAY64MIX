;--------------------------------------------------------------
; Normal key routines for navigating a 255 files dir:
;--------------------------------------------------------------

		;Y = key we pressed
		;A = 0

;--------------------------------------------------------------
;	Line up:
;--------------------------------------------------------------
		cpy #keyCrsrUp		;"Crsr up"
		bne key1
		lax pos_cursor		;zp
		ora offs_cursor		;abs
		beq td			;zero ? then do nothing
		txa			;lda pos_cursor
		beq th
		dec pos_cursor		;zp
		rts
th		dec offs_cursor		;abs
		rts

;--------------------------------------------------------------
;	Line down:
;--------------------------------------------------------------
key1		cpy #keyCrsrDown	;"Crsr down"
		bne key2
plt_inc		lda offs_cursor		;! also called from stack jumpb table
		sec
		adc pos_cursor
		cmp maxfile
		beq td
		lda pos_cursor
		cmp #maxDirY-1
		beq tj
		inc pos_cursor
		rts
tj		inc offs_cursor
td		rts
;--------------------------------------------------------------
;	Page UP:
;--------------------------------------------------------------
key2		cpy #keyCrsrLeft
		bne key3
		ldx pos_cursor		;A=0
		bne bd1
		lda offs_cursor
		sec
		sbc #maxDirY
		bcs bd2
		lda #0
bd2		sta offs_cursor
		rts
bd1		sta pos_cursor		;cursor pos to top of screen
		rts		

;--------------------------------------------------------------
;	Page Down:
;--------------------------------------------------------------
key3		cpy #keyCrsrRight
		bne key4
.if def_illegal
		lax maxfile
.else
		lda maxfile
		tax
.fi
		dex
		cpx #maxDirY-1
		bcc tp
		ldx #maxDirY-1
		cpx pos_cursor
		beq tq
tp		stx pos_cursor
		rts
tq		sec
		sbc #maxDirY
		bcs tr
		lda #0
tr		sta offs_cursor
		rts

key4		cpy #keySpace		;"SPACE"
		bne key5
ingenfil	pla
		pla
		jsr wjs_resetCia	;zp $01 = 36
.if !def_1541u2cmd			;no kernal routine for U2
		jsr ROM_clall           ;Close dirfile, and all other files..
.fi
		jmp (wjp_dirSelector)

key5
.if def_iec + def_1541u2cmd
		cpy #keyDelete
		bne key6
		tay			;Y=0 for going back directory level - dir_back
		beq dirbackw		;jmp
.fi		

key6		cpy #keyReturn		;"RETURN"
		bne key7
		ldy maxfile		;Y = 1-ff will be used at (wjp_load)
		beq ingenfil
dirbackw	pla
		pla
		jsr wjs_resetCia	;zp $01 = 36
		jmp (wjp_load)

;--- code continues in main source:
key7