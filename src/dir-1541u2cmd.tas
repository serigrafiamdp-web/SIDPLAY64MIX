;--------------------------------------------------------------
;  DIR-1541U2CMD
;
;  Read 1541U2 filenames + dirs and store them in dirbuffer.
;
;--------------------------------------------------------------
; * part of relocatable main
; * this routine is not a subroutine. no rts.
;--------------------------------------------------------------

		lda #dir_keys		;only a few keys available while loading dir
		sta numb		;00-0e - abs

;x+y=0
		;lda #>dirpos
		;sta dzp+1
		;ldy #0
		;sty pos_cursor		;zp
		;sty offs_cursor	;abs
		;sty maxfile		;zp
		;sty dzp		;zp
;ZP=$01 = 36
		dec $01			;35

		jsr wait_for_idle		;X+Y untouched

		ldx #$01                        ; OPEN DIR
		stx U2_Command_data_register
		ldy #$13
		sty U2_Command_data_register
		;ldx #_PUSH_CMD			;=$01
		stx U2_Control_register

		jsr wjs_wait_while_busy          ;;X+Y untouched - end command
;		jsr get_status

		lda #_DATA_ACC
		sta U2_Control_register

		jsr wait_for_idle		;X+Y untouched

		;ldx #$01                       ; READ DIR
		stx U2_Command_data_register
		iny	;ldy #$14
		sty U2_Command_data_register
		;ldx #_PUSH_CMD			;=$01
		stx U2_Control_register

nextdirentry
;zp $01 = 35
		jsr wjs_wait_while_busy
		ldy #0

		ldx maxfile
		;cpx #maxentries			;Reached the file limit ?
		;beq skipfile			;yes

		lda U2_Response_data_register   ; attribute byte
		and #_DA_DIR			; $10
		php				; zeroflag = 1 - means the entry is a file
						; zeroflag = 0 - means the entry is a dir
						
nextchar	lda U2_Status_register          ; any data left to process int this packet ?
		bpl nomorechars
		lda U2_Response_data_register   ; yes - print it
		dec $01				; 34
		sta (dzp),y			; store filename,y
		inc $01				; 35
		iny
		cpy #16
		bne nextchar
nomorechars	dec $01				; 34

		tya				; y = filename length
		plp
		beq notdir			; branches when zflag = 1
		ora #$80			; mark entry as a Directory
notdir		sta flengde,x			; store filename/dirname length

-		cpy #16
		beq +
		lda #$20			;fill the letters on the right of filename with spacebar
		sta (dzp),y			
		iny
		bne -
+
		
		inc $01				;35
		
		ldy $dc01
		dec $01				;34
		jsr check_addfile_entry
		inc $01				;35
		cpx #maxentries
		bne endof
		lda #_ABORT
		sta U2_Control_register
		bne plop
		
endof		

.COMMENT
		inc maxfile
		lda dzp				; go to next file in list
		clc
		adc #$10
		sta dzp
		bcc +
		inc dzp+1
+
.ENDC

		jsr wjs_display		;Displayfiles + Clock/PLT + Read keyboard
		lda #$35		;35
		sta $01
;skipfile		
;            jsr get_status                 ; here we need to get the status - after the packet is done, if we want to !

		lda #_DATA_ACC                  ; Go to next packet, if any
		sta U2_Control_register
		lda U2_Status_register
		and #_STATE
		cmp #_STATE_COMMAND_BUSY	; check if there is any more packets to process
		beq nextdirentry
plop

		; no more dir entries
			
;---------------------------------------
;WORKAROUND for U2 Command Interface bug
;where USB1.0 is not a directory if you don't enter it before in the selector
;---------------------------------------
.comment
		ldx #$38
		stx $01
		lda maxfile
		cmp #$02
		bne outcheck
        ldx #(16*2)-1
        txa
        clc
-       adc $d000,x
        dex
        bpl -
        cmp #$33        ; sum of SD + USB1.0 strings + $1f
        bne outcheck
		lda #$86
		sta flengde+1
outcheck
		ldx #$36
		stx $01
.endc		
;---------------------------------------

