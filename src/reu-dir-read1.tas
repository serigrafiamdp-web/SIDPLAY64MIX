DIRCMD	= $e808

		ldx $01
		lda #$38
		sta $01
		jsr prepare_loading_new_reu_dir	;only touch A register
		stx $01
		
		lda #$01
		ldx device
		ldy #$60
		jsr ROM_setlfs		;sta b8,ba,b9
		ldx #<dircmd		;E808 = $24
		ldy #>dircmd
		jsr ROM_setnam		;sta b7,bb,bc
		jsr ROM_open
		ldx #1			;Ide64 fix
		jsr ROM_chkin

;* skip disk header/id (2*10 = $20)
;* skip 2 bytes of file entry (1*2)
;zp $01 = 36 here            

;		ldy #$03		;disk header/id 
		ldy #$10+2
gri		jsr wjs_getbyte		;01   01   00           ;( = jsr ROM_chrin)
		tax
		jsr wjs_getbyte		;04   01   00
		dey
		bne gri
		tay			;cmp #0
		bne ta
					;Y = 0
		txa			
		beq ta			;Skip zerolength files
		
		pha			;blocks lo

		
-		jsr wjs_getbyte
		cmp #$22		;" wait for start of filename
		bne -
;----
		ldx #0			;set filename length to zero
		
getfname_loop	jsr wjs_getbyte
		cmp #$22		;" wait for end of filename
		bne getfname
		tya
		tax			;filename length 1-16 is now in X register
		
		lda #$20		;"space" sign
getfname	sta (dzp),y		;store letter
		iny
		cpy #$11		;max length
		bne getfname_loop
		
		txa
		bne +			;filename length unchanged and still zero ?
		tya			;yes, then we have a long filename and force it to $11
+		ldy #filename_entry_typelen
		sta (dzp),y
		
		pla	;blocks lo
		iny	;ldy #filename_entry_kbsize
		lsr	;convert filesize to
		lsr	;kilobyte (not exact)
		bne +
		lda #1		;force 1 kilobyte
+		sta (dzp),y
		
		
;this code is obsolete now when we use 1541u2cmd interface		
.if def_1541u2siec
;THIS assumes that all files from the 1541u2 sw iec
;has the .prg extension.
		;lda flengde,x
		sec
		sbc #4		;".prg"
		;sta flengde,x
		sta (dzp),y
.fi
		
		inc maxfile
		bne +
		inc maxfilehi		
+		
		lda dzp
		clc
		adc #filename_entry_size
		sta dzp
		bcc +
		inc dzp+1
+

		dec filecounter
		bne bci
		jsr write_reu_dir_entry
		;jsr adc_reu_page_position
bci


;		lda #$36
;		sta $01
		jsr wjs_display		;displayFiles+keyboard
		
ta		jsr wjs_getbyte		;wait for zero
		bne ta
		ldy #$02
		bne gri

;--------- Getbyte from Device --------------
;wjs_getbyte:   - do not touch x,y
;--------------------------------------------
getByte		
		lda #$36
		sta $01
		;lda maxfile
		;cmp #maxentries	;no limit check when using REU.
		;beq endofdir
		lda #0
		sta $90
		stx netdrivex		;TFR - Netdrive bug - zp
		jsr ROM_chrin
		ldx #$38
		stx $01
		ldx $90			;If status is zero then continue
		bne endofdir
		ldx netdrivex		;TFR - Netdrive bug - zp
		cmp #0
		rts
		
;---------Finished reading directory--------
endofdir	
		;lda #$38
		;sta $01

		jsr write_reu_dir_entry2
		;jsr adc_reu_page_position
		jsr zero_reu_datadr
		lda #$36
		sta $01
		
		pla
		pla
		lda #$01
		jsr ROM_close
		
;falls through to code