DIRCMD	= $e808

;x+y=0
		lda #dir_keys		;only a few keys available while loading dir
		sta numb		;00-0e - abs

		;lda #>dirpos
		;sta dzp+1
		;ldy #0
		;sty pos_cursor		;zp
		;sty offs_cursor	;abs
		;sty maxfile		;zp
		;sty dzp		;zp


		lda #1
		ldx device
;		ldy #0			;Y = 0
		jsr rom_setlfs		;sta b8,ba,b9
		ldx #<dircmd
		ldy #>dircmd
		jsr rom_setnam		;sta b7,bb,bc
		jsr rom_open
		ldx #1			;ide64 fix
		jsr rom_chkin

;* skip disk header/id (2*10 = $20)
;* skip 2 bytes of file entry (1*2)
;* get 2 bytes for blocksize for fileentry (1*2)

;zp $01 = 36 here

;---------- checking for zero after disk header:
		ldy #$1e
-		jsr wjs_getbyte
		dey
		bne -
-		jsr wjs_getbyte		;wait for zero to occur (incase long winvice dirnames)
		bne -
;now we have 01 01 followed by lsb, msb
;		
;-----
loop2		ldy #2
	
skip_header	jsr wjs_getbyte
		tax			;file entry block lo (lsb)
		jsr wjs_getbyte
					;file entry block hi (msb)
		dey
		bne skip_header
		tay			;cmp #0
		bne goof		;msb 0 blocks ?
		txa			;lsb 0 blocks ?
goof		sta zerofile		;both 0 blocks ? then mark this file as a zero file
		
gfn_start	JSR wjs_getbyte
		cmp #$22		;skip spaces or check first "
		bne gfn_start
;----
		ldy #0
		ldx #0
		;ldx maxfile
		;ldy #0			;start of name "
		;tya
		;sta flengde,x		;zerolength
		
		
getfname_loop	jsr wjs_getbyte		;start of name chars

		cmp #$22		;end of name "
		bne getfname
		tya
		tax
		
		;sta flengde,x		;if file has a 16 letter limit it will be set here
		
		lda #$20
getfname	sta (dzp),y		;store name letter
		iny
		cpy #$11
		bne getfname_loop	;

		txa
		bne +			;filename length unchanged and still zero ?
		tya			;yes, then we have a long filename and force it to $11
+		ldx maxfile
		sta flengde,x

		
;		dey			;10
;		tya
;		sta flengde,x		;
;		dey			;0f
;		lda #$2a		;put a "*" in the filename
;		sta (dzp),y

aye		
		
		
		
		
;wait for filentry to finish / scan for DIR entry
retry_dir	ldy #3			;reset dir search
scandir
fn_endloop	JSR wjs_getbyte		;Scan filetype (x+y unused)
		beq fn_endloop2		;exit

.if def_1541u_long
		cmp d64_txt,y
		beq found_d64
.fi		
		cmp dir_txt,y		;Look for " DIR" (PRG SEQ REL USR DEL)
		bne retry_dir
found_d64	dey
		bpl scandir
		sta zerofile		;"R" Enable DIR to be part of file listing.

.if def_1541u_long
		cmp #"4"		;"d64"
		bne adir
		lda #$c0		;d64
		.byte $2c
adir		lda #$80		;dir
		ora flengde,x
		sta flengde,x
		bne fn_endloop


.else		
;		ldx maxfile
		lda flengde,x		;Change file length to + $80 for DIR
		ora #$80
		sta flengde,x
		bne fn_endloop		;jmp
.fi
		
fn_endloop2
;a=00
;x=maxfile
		ldy #$35
		sty $01
		ldy $dc01
		dec $01			;34
		jsr check_addfile_entry
		cpx #maxentries
		beq endofdir
		
.comment
		lda zerofile
		beq bci
		lda dzp
		clc
		adc #$10
		sta dzp
		bcc +
		inc dzp+1
+		inc maxfile

bci
.endc

;zp $01 = 38 at this point
		jsr wjs_display		;Displayfiles + Clock/PLT + Read keyboard
		sec
		bcs loop2		;JMP


;--------- Getbyte from Device --------------
;wjs_getbyte:
;--------------------------------------------
getByte
		lda #$36
		sta $01
		lda #0			;no
		sta $90
		stx netdrivex		;TFR - Netdrive bug - zp
		jsr ROM_chrin
		ldx #$38
		stx $01
.comment		
		ldx maxfile
		cpx #maxentries
		beq endofdir
.endc		
		bit $90			;If status is zero then continue
		bne endofdir
		ldx netdrivex		;TFR - Netdrive bug - zp
		cmp #0
		rts
;---------Finished reading directory--------
endofdir	ldx maxfile		;we dont sort 1 file - must be 2 or more
		cpx #2
		bcc nofiles
		;lda #$38
		;sta $01
		jsr iec_dir_sort
nofiles		lda #$36
		sta $01
		pla
		pla
		lda #$01
		jsr ROM_close
;falls through to code