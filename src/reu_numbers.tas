;--------------------------------------------------------------
; REU - get reu adress
;--------------------------------------------------------------
;	* static subroutines
;	* location: d000-e000
;--------------------------------------------------------------
;calculate reu address for 16 bit input number (a,x)
;--- a = high filenumber
;--- y = low filenumer

;getreuadress
		sta zhi
		lsr		;When hi is 0,4,8,c,10...
		lsr
		sta zbank	;zbank change bank to 0,1,2,3,4...
		tya		;fcountlo, seed, lo value
		asl
		rol zhi		;*2
		asl
		rol zhi		;*4
		asl
		rol zhi		;*8
		asl
		rol zhi		;*$10
		asl
		rol zhi		;*$20
		asl
		rol zhi		;*$40
				;returns
		sta zlo		;a = lo
		ldx zhi		;x = hi
		ldy zbank	;y = bank
		rts

zlo	.byte 0
zhi	.byte 0
zbank	.byte 0
