;--------------------------------------------------------------
; 1541U2 REU - LOAD file / Change Dir
;--------------------------------------------------------------

;zp $01 = 36 when we enter here:

		jsr wait_for_idle		;X+Y free
		lda #$01
		sta U2_Command_data_register

		lda #$34
		sta $01

		tya			;y=0 goes back a dir
		bne u2notback
		lda #$80		;a=80
		bne dir_back
u2notback
				;89abcde
		lda #$2e	;|file: $042e
		sta gzp
		lda screenpos
		sta gzp+1

		jsr getpos		;location of filename 
		sta rzp			;lo adress
		stx rzp+1		;hi adress
		
		ldy #filename_entry_typelen	;filname length		
		;ldy #$10
		lda #$2a		;"*" wildcard
		.byte $2c		;falls through
		;ldy #$0f
plaz		lda (rzp),y

setwildc
		sta fname,y
		
		jsr convert_letter
		cpy #$10
		bcs *+4
		sta (gzp),y		;Write filename to screen at "|PSID:    "
		dey
		bpl plaz

		ldy #filename_entry_typelen	;filname length
		lda (rzp),y			;a = length of filename/dirname - falls through to setfname below
		

;A = file length 1-$3e for files or 81-$be for dirs
;A = 80 for going back a dir on 1541u2
;---------------------------------------------------
dir_back

		ldx #$36
.if !def_remember_DIR
		stx $01
.fi

		;tay	;a = length of filename/dirname 
		;tya	;a = length of filename/dirname 
		
		asl			;get rid of bit 7 & set CLC
		bcc loadfile
		lsr			;return bits 0-6 to original state
		bne gotodiru2
		
;go one dir level up here ("cd:..")
.if def_remember_DIR
		jsr check_upper_dir_limit	;AY=used
		inc $01				;35
.fi		
		lda #$11
		sta U2_Command_data_register
		lda #'.'
		sta U2_Command_data_register
		sta U2_Command_data_register
		bne endcd			;JMP

gotodiru2
; go to selected dir here
	
		ldy plt_flag
		cpy #2				;2=manual
		bne file_error2
		
		tax				;a = length of dirname

.if def_remember_DIR
		jsr remember_dir_pos		;A+Y used
		inc $01				;35
.fi		
		lda #$11
		sta U2_Command_data_register
		ldy #$00
-		lda fname,y
		sta U2_Command_data_register
		iny
		dex				;length of dirname=-1 
		bne -
		lda #'*'
		sta U2_Command_data_register
endcd						;jmp from above
		lda #_PUSH_CMD
		sta U2_Control_register
		jsr wjs_wait_while_busy		
		lda #_DATA_ACC
		sta U2_Control_register
		jmp (wjp_dirselector)		;calls ciaReset and zp$01=36

file_error2
		bne file_error


loadfile

.if def_remember_DIR
		stx $01				;36
.fi
		
;Load sid header

		lsr
		tax 				;a = length of filename
;		jsr wait_for_idle		
;		lda #$01
;		sta U2_Command_data_register		; this is already done before
		ldy #_DOS_CMD_OPEN_FILE			;_DOS_CMD_OPEN_FILE	= $02
		sty U2_Command_data_register
		;lda #_FA_READ				;_FA_READ		= $01
		dey					;$01
		sty U2_Command_data_register
		dey					;$00
		;ldy #$00
		sty $d011				; turn off screen
-		lda fname,y
		sta U2_Command_data_register
		iny
		dex	;cpy header
		bne -	;bne -
		lda #'*'
		sta U2_Command_data_register
		lda #_PUSH_CMD				;_PUSH_CMD	= $01
		sta U2_Control_register
		jsr wjs_wait_while_busy		
		
		jsr get_status				;AY=used, X=unused, uses zp to display text
		
		lda #_DATA_ACC                  	;_DATA_ACC	= $02  Go to next packet, if any
		sta U2_Control_register

		jsr wait_for_idle			;A=used

		ldy #$01
		sty U2_Command_data_register
		lda #_DOS_CMD_READ_DATA			;_DOS_CMD_READ_DATA	= $04
		sta U2_Command_data_register
		lda #$7e
		sta U2_Command_data_register	;7e read $007e bytes
		dey
		sty U2_Command_data_register	;00
		lda #_PUSH_CMD				;_PUSH_CMD = $01
		sta U2_Control_register

;		ldy #0
		
		jsr wjs_wait_while_busy
		
-		lda U2_Status_register          ; any data left to process int this packet ?
		bpl nomorechars1
		lda U2_Response_data_register   ; yes - print it
		
		; A = DATA here

		cpy #$76		;Convert text strings to petscii
		bcs gethb
		cpy #$16
		bcc gethb
		tax			;saves 1 byte 
		beq convspc		;Convert zeros to space
		cmp #$60
		bcc +
		and #$1f
+		.byte $2c
convspc		lda #$20
gethb		sta header,y
		iny
		bne -		

nomorechars1

		jsr get_status			;uses zp to display text
		
		lda #_DATA_ACC
		sta U2_Control_register     ; no need to wait for more since we know it is all in 1 packet

;code continues below here in root main source: