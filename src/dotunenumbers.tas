;--------------------------------------------------------------
; "dotunenumbers"
;  Handles tune numbers on screen when selecting subtunes
;  Also takes care of speedbits
;--------------------------------------------------------------
;	* static subroutine 
;	* location: d000-e000
;	* IRQ is OFF
;--------------------------------------------------------------
;
;replaced tzp by dzp
;
;bin, bincount, bcd and dzp are Zeropages


              ldx tune
              inx
              stx bin
              ldx maxtune
              inx
              stx bin+1	

              lda #<songstr1
              sta dzp
              lda screenpos
              clc
              adc #>songstr1&$03ff
              sta dzp+1

              ldy #0
              ldx #0
nextnumber    sed              ;Set decimal flag
              lda #0
              sta bcd
              sta bcd+1
              lda #8
              sta bincount
conbit        asl bin,x
              lda bcd
              adc bcd
              sta bcd
              lda bcd+1
              adc bcd+1
              sta bcd+1
              dec bincount
              bne conbit
              cld
            
              lda bcd+1
              beq higdec
              ora #$30
              sta (dzp),y
              iny
higdec        lda bcd
              and #$f0
              beq lodec
              lsr
              lsr
              lsr
              lsr
              ora #$30
              sta (dzp),y
              iny
lodec         lda bcd
              and #$0f
              ora #$30
              sta (dzp),y
              iny
              txa			;replaces cpx #0
              bne endbin
              lda #$2f
              sta (dzp),y
              iny
              inx
              bne nextnumber
              
endbin        

;this code for 1541u2+reu version:
.if def_1541u2cmd*def_reu
		lda #$20
-		cpy #5		 ;5 ("99/99") should be enough... no sid will ever have more than 99 songs ?
		bcs +
		sta (dzp),y
		iny
		bne -
+		
.else

;this code for all other versions:
		lda #$20          ;put some spaces behind
-		sta (dzp),y
		iny
		cpy #8		;was 8 --> 5 ("99/99") should be enough... no sid will ever have more than 99 songs ?
		bcc -

.fi

;Find speedbit for this song#

              ldx #0
              ldy #3
nextbyte      lda #8
              sta bincount
              lda speedtimer,y  ;32 bits, each bit represents a tune# telling if dc04/dc05 is on or off
nextbit       lsr
              pha
              lda #0              
              bcc bit0
              lda #1
bit0          sta speedbit	;zeropage
              pla
              cpx tune
              beq endbit
              inx
              dec bincount
              bne nextbit
              dey
              bpl nextbyte
endbit                          ;For tunes #32-255 the speedbit in bit 32 is used


;return sidtype to sidfx register
.if DEF_SIDFX
sidfxtype	ldx #0		;0,1,2,3 - unknown,6581,8580,both - value here from sid header of current song
		ldy sidfxtypes,x
		rts
sidfxtypes	.byte $f1	;unknown selects sid#1
sidfx_old	.byte $f1	;f1 - 6581 is on sid#1 / f2 - 6581 is on sid #2 - detected in setup
sidfx_new	.byte $f2	;f1 - 8580 is on sid#1 / f2 - 8580 is on sid #2 - detected in setup
		.byte $f1	;both selects sid#1
	
.fi

;return sidtype to chameleon register
.if DEF_CHAMELEON
chamelonsidtype	ldx #0
		ldy chamelonsidtypes,x
		rts
chamelonsidtypes
		.byte $00	;unknown selects old sid
		.byte $00	;6581 selects old sid
		.byte $c0	;8580 selects new sid
		.byte $00	;both selects old sid		
.else
		rts
.fi

