;--------------------------------------------------------------
; "dotunenumbers"
;  Handles tune numbers on screen when selecting subtunes
;  Also takes care of speedbits
;--------------------------------------------------------------
;	* static subroutine 
;	* location: d000-e000
;	* IRQ is OFF
;--------------------------------------------------------------
;
;replaced tzp by dzp

              ldx tune
              inx
              stx bin
              ldx maxtune
              inx
              stx bin+1

              lda #<songstr1
              sta dzp
              lda screenpos
              clc
              adc #>songstr1&$03ff
              sta dzp+1

              ldy #0
              ldx #0
nextnumber    sed              ;Set decimal flag
              lda #0
              sta bcd
              sta bcd+1
              lda #8
              sta bincount
conbit        asl bin,x
              lda bcd
              adc bcd
              sta bcd
              lda bcd+1
              adc bcd+1
              sta bcd+1
              dec bincount
              bne conbit
              cld
            
              lda bcd+1
              beq higdec
              ora #$30
              sta (dzp),y
              iny
higdec        lda bcd
              and #$f0
              beq lodec
              lsr
              lsr
              lsr
              lsr
              ora #$30
              sta (dzp),y
              iny
lodec         lda bcd
              and #$0f
              ora #$30
              sta (dzp),y
              iny
              cpx #0
              bne endbin
              lda #$2f
              sta (dzp),y
              iny
              inx
              bne nextnumber
endbin        
.if def_1541u2cmd*def_reu
		cpy #4
		bcs +
.fi
-		lda #$20          ;put some spaces behind
		sta (dzp),y
		iny
		cpy #5		;was 8 --> 5 ("99/99") should be enough... no sid will ever have more than 99 songs ?
		bcc -
+

;Find speedbit for this song#

              ldx #0
              ldy #3
nextbyte      lda #8
              sta bincount
              lda speedtimer,y  ;32 bits, each bit represents a tune# telling if dc04/dc05 is on or off
nextbit       lsr
              pha
              lda #0              
              bcc bit0
              lda #1
bit0          sta speedbit	;zeropage
              pla
              cpx tune
              beq endbit
              inx
              dec bincount
              bne nextbit
              dey
              bpl nextbyte
endbit                          ;For tunes #32-255 the speedbit in bit 32 is used
              rts
