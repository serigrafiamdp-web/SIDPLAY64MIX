;--------------------------------------------------------------
; "iec_fileinfo"
;
;  IEC sort files + directories
;--------------------------------------------------------------
;	* static subroutine 
;	* location: d000-e000
;	* Used while IRQ is running!!
;--------------------------------------------------------------

;dir entry number in hex

		lda flengde,x
		bpl normalfiles
		ldy #"d"		
.if def_1541u_long
		asl
		bmi dd64
.fi		
		;ldy #"d"
		ldx #"i"		;"DIR"
		lda #"r"
		bne prnt

.if def_1541u_long
dd64
		;ldy #"d"
		ldx #"6"		;"D64"
		lda #"4"
		bne prnt
.fi
		
normalfiles	lda #$20		;space
		tax			;space
		tay			;space
		
prnt		sty setd+1
		ldy #$14
		sta (gzp),y		;print A
		dey
		txa
		sta (gzp),y		;print X
		dey
setd		lda #$3a		;":"
		sta (gzp),y
		rts		
