;--------------------------------------------------------------
; "convert_letter"
;  Handles letter conversion
;--------------------------------------------------------------
;	* static subroutine 
;	* location: d000-e000
;--------------------------------------------------------------
		cmp #$a4		;1541 ultimate uses $a4 for underscore
		beq underscore		;
		
;		and #$7f		;
		cmp #$7f		;Underscore from browsing dirs with vice
		beq underscore
		
		cmp #$5f		;PC underscore is "_" 5f
;		bcc nope            
		beq underscore

;        cmp #$41
;        bcc notupper
;        cmp #$5b
;        bcs notupper

;        and #%00111111
;        rts
        
;notupper
        cmp #$61
        bcc notlower
        cmp #$7b
        bcs notlower

        and #%00011111
notlower
        rts
        

;		eor #$20	;letter 60-7e converted to 40-5e
;		.byte $2c
underscore	lda #$64	;C64 version of the underscore sign
nope            
		rts                 


;ASCII:
;41-5A (A-Z uppercase)
;61-7A (a-z lowercase)
;
;real PETSCII:
;01-1A (A-Z uppercase)
;41-5A (a-z upperrcase)

;PETSCII:
;41-5A (a-z lowercase)
;C1-DA (A-Z uppercase)
;
;SD2IEC:
;Converts letters to petscii when we read the dir entries.
;FF      in the sd2iec filename tells us that the filename is longer than 16 letters.
;        example: "touchi_1.sid" (where "_" = $ff )
;
;Equal for ascii & petscii:
;20-3F
;
;pclink and netdrive $a4 sign as "_"
;
