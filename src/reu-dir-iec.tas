DIRCMD	= $e808

		ldx $01
		lda #$38
		sta $01
		jsr prepare_loading_new_reu_dir	;only touch A register
		stx $01

		lda #1
		ldx device
		ldy #0			;Y = 0
		jsr rom_setlfs		;sta b8,ba,b9
		ldx #<dircmd
		ldy #>dircmd
		jsr rom_setnam		;sta b7,bb,bc
		jsr rom_open
		ldx #1			;ide64 fix
		jsr rom_chkin

;* skip disk header/id (2*10 = $20)
;* skip 2 bytes of file entry (1*2)
;* get 2 bytes for blocksize for fileentry (1*2)

;zp $01 = 36 here

;---------- checking for zero after disk header:
		ldy #$1e
-		jsr wjs_getbyte
		dey
		bne -
-		jsr wjs_getbyte		;wait for zero to occur (incase long winvice dirnames)
		bne -
;now we have 01 01 followed by lsb, msb
;		
;-----
		ldy #2
		;ldy #$10+2
skip_header	jsr wjs_getbyte
		tax			;file entry block lo (lsb)
		jsr wjs_getbyte
					;file entry block hi (msb)
		dey
skip2		bne skip_header
		tay			;cmp #0
		bne goof		;msb 0 blocks ?
					;Y=0
		txa			;lsb 0 blocks ?
goof		sta zerofile		;both 0 blocks ? then zero
		
-		JSR wjs_getbyte
		cmp #$22		;" wait for start of filename
		bne -
;----
		ldy #0
		ldx #0 		;set filename length to zero

getfname_loop	jsr wjs_getbyte		;filename letters here
		cmp #$22		;" wait for end of filename
		bne getfname
		tya
		tax			;filename length 1-16 is now in X register

		lda #$20		;"space" sign
getfname	sta (dzp),y		;store letter

		iny
		cpy #$11		;max length
		bne getfname_loop

		txa
		bne +			;filename length unchanged and still zero ?
		tya			;yes, then we have a long filename and force it to $11
+		ldy #filename_entry_typelen
		sta (dzp),y
	

		
;wait for filentry to finish / scan for DIR entry
retry_dir	ldx #3			;reset dir search
scandir
fn_endloop	JSR wjs_getbyte		;Scan filetype
		beq fn_endloop2		;exit

.if def_1541u_long
		cmp d64_txt,x		;"46D "
		beq found_d64
.fi		
		cmp dir_txt,x		;"RID " Look for " DIR" (PRG SEQ REL USR DEL)
		bne retry_dir
found_d64	dex
		bpl scandir
		sta zerofile		;"R"

.if def_1541u_long
		cmp #"4"		;"d64"
		bne adir
		lda #$c0		;d64
		.byte $2c
adir		lda #$80		;dir
		;ldy #filename_entry_typelen
		ora (dzp),y
		sta (dzp),y
		bne fn_endloop		;jmp


.else		
		;ldy #filename_entry_typelen
		lda (dzp),y		
		ora #$80		;Change file length to + $80 for DIR
		sta (dzp),y
		bne fn_endloop		;jmp
.fi
		
fn_endloop2
		jsr check_addfile_entry	;static rom d000-e000

		jsr wjs_display		;displayFiles+read keyboard
		ldy #2
.if def_1541u_long		
		bne skip2		;gives branch error on 1541u+netdrive version
.else		
		bne skip_header	
.fi


;--------- Getbyte from Device --------------
;wjs_getbyte:
;--------------------------------------------
getByte
		lda #$36
		sta $01
		lda #0
		sta $90
		stx netdrivex		;TFR - Netdrive bug - zp
		jsr ROM_chrin
		ldx #$38
		stx $01
		ldx $90			;If status is zero then continue
		bne endofdir
		ldx netdrivex		;TFR - Netdrive bug - zp
		cmp #0
		rts
;---------Finished reading directory--------
endofdir	
		jsr write_reu_dir_entry2
		jsr zero_reu_datadr

.if def_remember_dir
		jsr get_dir_pos
.fi

nofiles		lda #$36
		sta $01
		pla
		pla
		lda #$01
		jsr ROM_close
;falls through to code