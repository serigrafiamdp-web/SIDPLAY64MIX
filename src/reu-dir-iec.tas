DIRCMD	= $e808

		ldx $01
		lda #$38
		sta $01
		jsr prepare_loading_new_reu_dir	;only touch A register
		stx $01

		lda #1
		ldx device
		ldy #0			;Y = 0
		jsr rom_setlfs		;sta b8,ba,b9
		ldx #<dircmd
		ldy #>dircmd
		jsr rom_setnam		;sta b7,bb,bc
		jsr rom_open
		ldx #1			;ide64 fix
		jsr rom_chkin

;* skip disk header/id (2*10 = $20)
;* skip 2 bytes of file entry (1*2)
;* get 2 bytes for blocksize for fileentry (1*2)

;zp $01 = 36 here

		ldy #$10+2
skip_header	jsr wjs_getbyte
		tax			;file entry block lo (lsb)
		jsr wjs_getbyte
					;file entry block hi (msb)
		dey
		bne skip_header
		tay			;cmp #0
		bne goof		;msb 0 blocks ?
					;Y=0
		txa			;lsb 0 blocks ?
goof		sta zerofile		;both 0 blocks ? then zero

-		JSR wjs_getbyte
		cmp #$22		;" wait for start of filename
		bne -
;----
		ldy #0
		ldx #0 		;set filename length to zero

getfname_loop	jsr wjs_getbyte		;filename letters here
		cmp #$22		;" wait for end of filename
		bne getfname
		tya
		tax			;filename length 1-16 is now in X register
		
		lda #$20		;"space" sign
getfname	sta (dzp),y		;store letter
		iny
		cpy #$11		;max length
		bne getfname_loop

		txa
		bne +			;filename length unchanged and still zero ?
		tya			;yes, then we have a long filename and force it to $11
+		ldy #filename_entry_size-1
		sta (dzp),y
	

		
;wait for filentry to finish / scan for DIR entry
retry_dir	ldx #3			;reset dir search
scandir
fn_endloop	JSR wjs_getbyte		;Scan filetype
		beq fn_endloop2		;exit

.if def_1541u_long
		cmp d64_txt,x		;"46D "
		beq found_d64
.fi		
		cmp dir_txt,x		;"RID " Look for " DIR" (PRG SEQ REL USR DEL)
		bne retry_dir
found_d64	dex
		bpl scandir
		sta zerofile		;"R"

.if def_1541u_long
		cmp #"4"		;"d64"
		bne adir
		lda #$c0		;d64
		.byte $2c
adir		lda #$80		;dir
		;ldy #filename_entry_size-1
		ora (dzp),y
		sta (dzp),y
		bne fn_endloop		;jmp


.else		
		;ldy #filename_entry_size-1
		lda (dzp),y		
		ora #$80		;Change file length to + $80 for DIR
		sta (dzp),y
		bne fn_endloop		;jmp
.fi
		
fn_endloop2
		lda zerofile		;dont allow zerofiles
		beq bci
		
		inc maxfile
		bne +
		inc maxfilehi
+
		lda dzp
		clc
		adc #filename_entry_size
		sta dzp
		bcc +
		inc dzp+1
+
		dec filecounter
		bne bci
		jsr write_reu_dir_entry
		;jsr adc_reu_page_position
bci

;		lda #$36
;		sta $01
		jsr wjs_display		;displayFiles+read keyboard
;		jsr wjs_ffe4		;read keyboard
		ldy #2
		bne skip_header


;--------- Getbyte from Device --------------
;wjs_getbyte:
;--------------------------------------------
getByte
		lda #$36
		sta $01
		;lda maxfile
		;cmp #maxentries	;no limit check when using REU.
		;beq endofdir		
		lda #0
		sta $90
		stx netdrivex		;TFR - Netdrive bug
		jsr ROM_chrin
		ldx netdrivex		;TFR - Netdrive bug
		pha
		lda #$38
		sta $01
		pla
		inc $90			;Checks if $90 is zero without changing
		dec $90			;A,X or Y
		bne endofdir
		cmp #0
		rts
;---------Finished reading directory--------
endofdir	
		jsr write_reu_dir_entry2
		;jsr adc_reu_page_position
		jsr zero_reu_datadr
		
;		lda maxfile		;we dont sort 1 file
;		cmp #2			;must be 2 or more
;		bcc nofiles
;		lda #$38
;		sta $01
;		jsr iec_dir_sort

nofiles		lda #$36
		sta $01
		pla
		pla
		lda #$01
		jsr ROM_close
;falls through to code