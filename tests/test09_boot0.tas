; TEST09 SIMBIONTE - Stage 0 at $0801.
; Load Stage1 at $7C00 with KERNAL before invoking original Glenn.
; ZERO changes to Glenn packed binary; KRILL is only STAGED, not installed.
* = $0801
        .word $080b
        .word 10
        .byte $9e,$32,$30,$36,$31,0   ; 10 SYS2061
        .word 0
* = $080d
boot
        sei
        lda #$06
        sta $d020
        lda #stage1_name_end-stage1_name
        ldx #<stage1_name
        ldy #>stage1_name
        jsr $ffbd                   ; SETNAM
        lda #1
        ldx #8
        ldy #1                      ; use embedded load address
        jsr $ffba                   ; SETLFS
        lda #0
        tax
        tay
        jsr $ffd5                   ; LOAD
        bcs failure
        jmp $7c00                  ; Stage 1 outside loaded helper ranges
failure
        sta $0400
        lda #$02
        sta $d020
halt
        jmp halt
stage1_name
        .text "SYMBIONT"
stage1_name_end
