;--------------------------------------------------------------
.cerror *>$dfe2,"program below $dfe2 too long!"
;--------------------------------------------------------------
;dfe2-dfff = 0314-0331 backup of original vectors
* = $dfe2 ;+$1e=e000
vectors

.else
;serial, iec, all devices that loads with kernal routines:
;--------------------------------------------------------------
.cerror *>$df66,"program below $df66 too long!"
;--------------------------------------------------------------
;df66-df84 = 0314-0331 backup of original vectors
* = $df66 ;+$1e=df84
vectors
.fi


;If a file loads to $e000:
;It will load to $df84 because of the $7c sid header
maxentries = (lastpos-dirpos)/16 ;=168 files


