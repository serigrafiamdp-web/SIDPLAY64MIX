  .else
  .include src/load-iec-serial.tas
  .fi
.fi ;DEF_REU

;zp $01 = 36
		lda magicid+1
		cmp #$53		;pSid/rSid
		beq idook
file_error	ldx plt_flag
		beq donext		;0   next
		bmi donext   		;80+ random
		stx $d020		;2 = error
		
		;jmp (wjp_dirselector)	;|old behaviour - if error with loading sid file reload directory
		
		lda #$1b		;|new
		sta $d011		;|new
		jmp (wjp_fileselect)	;|new behaviour - if error loading sid file, return to file selectort
		
donext		jmp (wjp_pltadvance)	;try next file in dir
;siderror	jmp (wjp_fileselect)	;return to fileselector - this sid is using $0000 as play address - unfortunately with all keys on.
         
idook		

		lda playAddress+1	;lo part of play call
		ora playAddress		;hi part of play call (checking for $0000 which is typical for RSID.. and only a few PSID)
skiprsid	beq file_error		;$24;siderro	;wrong sid type
		
		sei			;! Must set SEI here, because doheaderstuff does a stack jump to "returnhere" if eveything is ok,
		lda #$38		;! if not we do a stack jump to "memoryerror"
		sta $01
		jmp doheaderstuff	;src/doheaderstuff.tas

returnHere                      ;returns with stackjump here from doheaderstuff
				;A=$36
		;lda #$36
		sta $01

;Find correct $dd00

.if def_illegal
		lax screenpos	;lda,tax
		alr #%11000000	;and #, lsr
				;saves 1 byte
		lsr
		lsr
		lsr
		lsr
		lsr

.else
		lda screenpos
		tax
		and #%11000000
		lsr
		lsr
		lsr
		lsr
		lsr
		lsr
.fi		             
		
		eor #%00000011
		sta $dd00
		tay
                
;Find correct $d018
;Locate videoram pointer (screen 0400-07e8)

		txa 
		and #$3f
		asl
		asl
		sta tmp
;Locate charset pointer (font 2000-2800)
		lda #%00000110 ;Rom font (1000/9000)
		cpy #3         ;0000-4000
		beq romchar
		cpy #1         ;8000-c000
		beq romchar
		
		lda fontpos    ;Banks 4000-8000 and c000-00000
		sta gzp+1
.if def_illegal
		alr #$3f	;and #, lsr
				;saves 1 byte
		lsr
.else
		and #$3f       ;Needs a copy of the romcharset
		lsr
		lsr
.fi
		pha
		lda #$33		;Enable char rom (D000-E000)
		sta $01
		lda #$d8
		sta rzp+1
	
		ldx #8			;7 pages of font to copy
		ldy #0
		sty rzp
		sty gzp
RRomset		lda (rzp),y
		sta (gzp),y
		iny
		bne RRomset
		inc rzp+1
		inc gzp+1
		dex
		bne RRomset
		
		lda #$36
		sta $01
		
		pla
		
romchar		ora tmp
		sta $d018

;-- Adjust jmp's to new screenpos:

		ldx #3*2                 ;0,1,2,3,4 entries
		ldy #3
adjust1		lda screenpos
		clc
		adc wjp_add,y
		sta wjp_dirselector+1,x
		dey
		dex
		dex
		bpl adjust1

;-- Adjust jsr's to new screenpos:

		ldx #6*3                ;0,1,2,3,4,5,6,7,8 entries
		ldy #6
adjust2		lda screenpos
		clc
		adc wjs_add,y
		sta wjs_jumps+2,x
		dey
		dex
		dex
		dex
		bpl adjust2
           
;load file into mem

;X=$fd
;y=$ff

.if def_1541u2cmd
; Read remaining stuff here
		;lda v2loadaddress	- load adress is set in src/doheaderstuff.tas
		;sta ldzp
		;lda v2loadaddress+1
		;sta ldzp+1

		jsr wait_for_idle		;x+y untouched

		ldx #$01
		stx U2_Command_data_register
		lda #_DOS_CMD_READ_DATA
		sta U2_Command_data_register
		tya
		;lda #$ff
		sta U2_Command_data_register
		;lda #$ff
		sta U2_Command_data_register
		;ldx #_PUSH_CMD			;=$01
		stx U2_Control_register


		;ldy #0
		iny				;0
		lda panic_load_u2		;a=0 on panic
		bne nextpacket2
		sta $01				;all ram 0000-fffff
		jmp u2_start_panic_load		
nextpacket2
		jsr wjs_wait_while_busy		
		
-		lda U2_Status_register          ; any data left to process int this packet ?
		bpl nomorechars2
		lda U2_Response_data_register   ; yes - print it
		
		; A = DATA here
		sta (ldzp),y			;zp $01 = 36 - Can safely write to 0000-cfff and e000-ffff
		inc ldzp
		bne -
		inc ldzp+1
		bne -				;(jmp) never zero
		
nomorechars2

		jsr get_status

		lda #_DATA_ACC                  ; Go to next packet, if any
		sta U2_Control_register
		lda U2_Status_register
		and #_STATE
		cmp #_STATE_COMMAND_BUSY        ; check if there is any more packets to process
		beq nextpacket2
		
;ldzp = endAdrLo and now contains the end load adress.


.else
		lda #0
		;sta $90		;status is set to zero by ROM_load routine at $f4a5
		sta $b9			;IDE64 again
           	ldx loadAdrLo
		ldy loadAdrHi
		bit panicload+1		;A turns to 0 on panic
		bmi nopanic
		jmp panic_load
nopanic		jsr ROM_load		;Returns X = endadr lo
					;Returns Y = endadr hi
		;stx endAdrLo
		;sty endAdrHi
.endif

