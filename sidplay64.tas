;--------------------------------------------------------------
;         SIDPLAY 64
;--------------------------------------------------------------
;         Programmed by:
;         Glenn Rune Gallefoss / SHAPE / Nostalgia (2005-2018)
;
;         Additional programming:
;         Tomaz Kac (Tom-Cat) / Nostalgia          (2015-2016)
;--------------------------------------------------------------
; * All hvsc sids are version 2 or version 3
; * All hvsc sids have a $7c header
; * All hvsc sids use timers dc04/dc05 if speedflag is used
;--------------------------------------------------------------
; $D01A = 0, but enabled when jumping into a song using own interrupt handler.
; $D019 Not used in irq, but enabled when jumping into a song using own interrupt handler.
; $DC0D - The irq is a timer irq, so $dc0d must be read for each irq triggered.
;--------------------------------------------------------------
;DEF_SIDFX	= 1	;1 = enable SIDFX routines (all versions) - Can't be combine with Chameleon. 
;			;currently defined in make bat file
;--------------------------------------------------------------
;DEF_REU	= 0	;1 = enable reu routines (all versions) - Can't be combined with Chameleon.
;			;currently defined in make bat file
;--------------------------------------------------------------
def_currentdate	= 1	;1 = include current clock and date in build.
def_illegal	= 1	;1 = use illegal opcodes
def_colorselect	= 1	;use 1.  0 = for debugging new colors.
def_attractmode = 2	;0 = no attract mode, 1= basic attract mode, 2 = smooth attract mode
;--------------------------------------------------------------
def_remember_DIR = 1	; This option is only for the REU versions of 1541u2 and iec,cmd & ide64 drives
;--------------------------------------------------------------
def_basic	= 1	; Enable BASIC sids to be runned and played.

; TEST03 opt-in: defaults OFF, original make.bat stays compatible.
.weak
DEF_MIX03 = 0
.endweak
.weak
DEF_MIX10 = 0
.endweak
;--------------------------------------------------------------

.include sidplay64.cfg	;see this file for Defset's

;--------------------------------------------------------------
;         Kernal Addresses and other definitions:
;--------------------------------------------------------------
.include src/kernal.tas		;list of useful kernal adresses
.include src/1541u2_defines.tas ;list of 1541u2 addressing
.if DEF_REU
.include src/reu_defines.tas
.fi

;--------------------------------------------------------------
;         Zeropages used during DISK I/O:
;--------------------------------------------------------------
header		= $0c
magicID		= header	;+00 - 4 bytes	- "psid" or"rsid"
version		= header+$04	;+04 - word	-  version 0001/0002/0003 (rsid+psid v2ng)
dataoffset	= header+$06	;+06 - word	- dataoffset to the c64 binary
loadAddress	= header+$08	; used for timer minutes
initAddress	= header+$0a
playAddress	= header+$0c
songs		= header+$0e
startSong	= header+$10
speed		= header+$12
sidname		= header+$16
sidauthor	= header+$36
sidreleased	= header+$56
v1data
flags		= header+$76
startPage	= header+$78   ;at 84
pageLength	= header+$79   ;at 85
reserved	= header+$7a   ;v3+v4 sid header contains adress for 2nd and 3rd sid - (WE USE THEM FOR INJECTING SONGLENGTH MINUTES|SECONDS)
v2data
v2loadaddress	= header+$7c ;binary loadadress

status		= $90 ;

endAdrHi	= $af	;$f0 ;|
endAdrLo	= $ae	;$f1 ;|

ldzp		= endAdrLo	;For 1541u2 only - same as zp $ae,af

netdrivex	= $f1
countdir	= $f2	;Zp dir sorter
countfile	= $f3	;Zp dir sorter
tmp		= $f4 ;
relocsize	= $f5 ;
startbank	= $f6 ;
dzp		= $fc ;|word - zp for reading in new directory
loadAdrLo	= $fe ;|Startadress - header offset ($76 or $7c)
loadAdrHi	= $ff ;|


;--------------------------------------------------------------
;         Zeropages used during play and irq:
;--------------------------------------------------------------

pos_cursor	= $02	;Visible # limit for filenames
zerop		= pos_cursor
maxfile		= $03	;Keeps track of # of files in memory
gzp		= $04	;word
rzp		= $06	;word
speedbit	= $08	;byte	- note : this zp is updated by dotunenumbers.tas and should not be zerofilled by "ciareset"
;--------------------------------------------------------------
firstzp		= pos_cursor
lastzp		= speedbit;rzp+1

zpBuffSize	= ( lastzp - firstzp) +1 ;9 end of zeropage address 

zpclear		= zpBuffsize + 2	;$0009-$00ff

;--------------------------------------------------------------
;zps 09,0a,0b  is not used anylonger


;-------- Safe Zeropages when restarting a tune (000c-0100 is zero filled during init)

bcd		= $0c	;|word	- dotuneumbers.tas
bin		= bcd+2	;|word  - dotuneumbers.tas
bincount	= bin+2 ;|byte  - dotuneumbers.tas

;--------------- static memory adressing:
fname		= $0200
playBuf		= $d000		;d000-d006
editBuf		= $d007		;d007-d00d

;Free IO bytes to be used:
;$d00e
;$d00f

offs_cursor	= $d017		;Offset for filenames

keydelay	= $d010
seed		= $d01c
lastkey		= $d01d
bakd011		= $d01b

;d015	;cant use

;--------------------------------------------------------------
;         SIDPLAY64 STACK JUMPS, TABLES, DATA
;--------------------------------------------------------------
topstack	= $ff        ;$01fb

               * = $1100
stack 
               * = $0115
               .offs stack-*
stacker


numb		.byte dir_keys		;low nibble only (numb uses 00-0e )

minuteshi	.byte $30
minuteslo	.byte $33
		.byte $3a   ;:
secondshi	.byte $30
secondslo	.byte $35

;\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\
wjs_jumps
.if DEF_REU
wjs_exe_reucomm	jmp execute_reu_command ;00-jmp $XX00
.else
wjs_playlist	jmp plt_inc         ;00-jmp $XX00
.fi
wjs_restartTune	jmp restartTune     ;01-jmp $XX00
wjs_resetCia	jmp resetCia        ;03-jmp $XX00
wjs_display	jmp displayfiles    ;05-jmp $XX00
.if def_1541u2cmd
wjs_wait_while_busy jmp wait_while_busy ;06-jmp $XX00
.else
wjs_getbyte	jmp getbyte         ;06-jmp $XX00
.fi
stack_irq	jmp irq             ;07-jmp $XX00	fffe/ffff
stack_hwirq	jmp hwirq           ;08-jmp $XX00	0314/0315
;\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\

wjs_add		
.if DEF_REU
		.byte >(execute_reu_command-screen2);highbyte Offset from screen
.else
		.byte >(plt_inc-screen2)      ;highbyte Offset from screen
.fi
		.byte >(restartTune-screen2)  ;highbyte Offset from screen
		.byte >(resetCia-screen2)     ;highbyte Offset from screen
		.byte >(displayfiles-screen2) ;highbyte Offset from screen
.if def_1541u2cmd
		.byte >(wait_while_busy-screen2)      ;highbyte Offset from screen
.else
		.byte >(getbyte-screen2)      ;highbyte Offset from screen
.fi
		.byte >(irq-screen2)          ;highbyte Offset from screen
		.byte >(hwirq-screen2)        ;highbyte Offset from screen
;\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\
initMus		jmp initMus        ;jmp $xxxx
playMus		jmp playMus        ;jmp $xxxx
stopMusic	.byte 0            ;byte 1-ff = music on... 0 = music off

;\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\
stack_nmi	;sei					;0318+fffa
		ldx #zpBuffSize-1
-		lda editbuf,x		;d00x
		sta zerop,x		;0002
		dex
		bpl -
		txs
		.byte $4c				;jmp (wjp_dirselector)
		
wjp_dirselector	.word dirselector  ;00-word - jmp direselector
wjp_fileselect	.word fileselect   ;01-word - jmp fileselect
wjp_load	.word load         ;02-word - jmp load
wjp_pltadvance	.word plt_advance  ;03-word - jmp plt_advance

wjp_add		.byte >(dirselector-screen2)  ;highbyte Offset from screen
		.byte >(fileselect-screen2)   ;highbyte Offset from screen
		.byte >(load-screen2)         ;highbyte Offset from screen
		.byte >(plt_advance-screen2)  ;highbyte Offset from screen

screenpos	.byte $C4
fontpos		.byte $e0

device		.byte 0
plt_flag	.byte 2              ;$02 = manual select (color red too)
                                     ;$00 = shuffle to next
                                     ;$80 = shuffle random
plt_letter	.byte $4d             ;M,N,R                                     
samefile	.byte 0
tune		.byte 0              ;|Should stay
maxtune		.byte 0              ;|next to each other

speedtimer	.byte 0,0,0,0        ;0 bit = standard irq
                                     ;1 bit = dc04/dc05 
                                     
tunesystem	.byte 1              ;00 = unknown  bits 1,0  byte $00
                                     ;01 = pal      bits 1,0  byte $01
                                     ;10 = ntsc     bits 1,0  byte $02
                                     ;11 = both     bits 1,0  byte $03


.if def_1541u2cmd
wait_for_idle
-		lda U2_Status_register
		and #_STATE
		bne -
		rts
get_status	lda #<txterror1
		sta rzp
		lda screenpos
		clc
		adc #>txterror1&$03ff
		sta rzp+1
		ldy #$00
		bit U2_Status_register
		bvc nostatus			; no message - don't clear status, leave it
-		bit U2_Status_register
		bvc +				; if finished clear the rest of the line
		lda U2_Staus_data_register
		.byte $2c
+		lda #$20		
		sta (rzp),y
		iny
		cpy #38				;1541u2 status messages are never longer than 38 letters.
		bne -
nostatus	rts

panic_load_u2	.byte $ff			;1541u2 panic load code is transfered here

		
.else

panic_load				
;zp $01 = 36 when entering here:
;dont change Y (loadardhi)
		lda #$38
		sta $01

		ldx #5
copyp2		lda panic_0314,x	;0314,15,16,17,18,19
		sta $0314,x		;Buffer irq vectors for panic load
		dex
		bpl copyp2
		lda #$36
		sta $01
           	ldx loadAdrLo
panicload	lda #$ff		;For cases where ther is no memory and sid is a rsid (playaddress $0000):
					;We change panicload+1 to zero, load the file, run it and hope for the best.  No exit to sp64.
		jsr ROM_load
.if def_illegal
		lax tune
.else
		lda tune
		tax
.fi		
		tay
		jsr initmus
		jmp *

.fi
;----------------------0123456789abcdef01234
.if DEF_REU
.else
nofile		.text "no files present     "	;present here in the normal non-reu version
.fi
;----------------------0123456789abcdef012
              
;-------------------------
.if def_iec
diskimage			;IEC - 1-ff no disk image, 0 = disk image
zerofile	.byte 0		;IEC - used in dir-load to check if a file has zero blocks
dircommand
.text "cd:"			;IEC - open dir
dirname				;IEC - dirname to open
.fi
;-------------------------
endstacker
              * = *-stacker+stack
              .offs 0


.if DEF_MIX10
; TEST10 resident symbiont ($3000) -- static overlay to avoid relocating Glenn.
        * = $3000
.include src/mix10_glenn_symbiont.tas
.cerror *>$3600,"TEST10 symbiont must fit in $3000-$35ff"
        ; TEST27: immutable Krill setup payloads embedded inside the
        ; SINGLE C64 PRG. Their memory is temporary: installer $6000,
        ; resident backup $8800 -> live $9000 after Glenn relocates.
        ; Binary resources are produced from frozen TEST19 in CI,
        ; checked byte-for-byte against original file payloads.
        * = $6000
        .binary "assets/krill_insta_payload.bin"
        .cerror *>$7b00,"Krill installer exceeded reserved startup region"
        * = $8800
        .binary "assets/krill_resident_payload.bin"
        .cerror *>$8a00,"Krill resident backup exceeded reserved region"
.fi

.if DEF_MIX03
; TEST03A experimental helper at $3000-$30ff for the restricted SIDTRACKER
; set only (all payloads $1000-$291e). Generic SIDs CAN overwrite this.
        * = $3000
.include src/mix03_timer_hook.tas
.cerror *>$3100,"TEST03A helper too large for $3000-$30ff"
.fi

.if DEF_CHAMELEON*DEF_SIDFX
.error "You can't compile SIDFX together with CHAMELEON!!"
.fi

.if DEF_CHAMELEON*DEF_REU
.error "You can't compile REU together with CHAMELEON!!"
.fi

		
		* = $9000
;--------------------------------------------------------------
;         SIDPLAY64 INITIAL RUN
;--------------------------------------------------------------
;         This code is only runned once to 
;         setup stack, colors, memory, code.
;         Jumps to label "start" to begin sidplay64.
;--------------------------------------------------------------
;Sidplay64 is started with a call to $c000  on startup:
.if def_colorselect
.include src/init.tas
.else
.include src/init2.tas	;just for testing new colors
.fi
.include src/devicecheck.tas
.include src/joyport1.tas
;.include src/joyport2.tas
.if DEF_REU
reu_detection
.include src/reu_detect.tas
.fi


.align $0100
attract_mode
.if def_attractmode = 1
.include src/attract_mode2.tas
.fi
.if def_attractmode = 2
.include src/irq-attract-mode.tas
.fi

;--------------------------------------------------------------



;--------------------------------------------------------------
;         SIDPLAY64 
;--------------------------------------------------------------
;         Program
;--------------------------------------------------------------
screen1		= $0400
screen2		= $c400
screen2chars	= $e000 ;e000-e800
;-----------
.if def_1541u2cmd*DEF_REU
credz		= (screen1&$03ff)+($d807+(40*3))	;|REU
songstr1	= screen1+(40*6)+7			;|
timestr1	= screen1+(40*20)+4			;|
dirscreen	= screen2+(40*7)+13			;|
;-----------
.else
credz		= (screen1&$03ff)+($d808+(40*3))
songstr1	= screen1+(40*6)+8
timestr1	= screen1+(40*20)+9
dirscreen	= screen2+(40*7)+18
.fi
;-----------
txterror1	= screen1+$0399
maxDirY		= 15




;--------------------------------------------------------------

		* = $c400
		scr_version = *
.if def_1541u2cmd
	.if def_reu
		.binary "bin/screen-1541u2reu.o64",2	;1541u2cmd reu version
		* = scr_version+$02d5
		.include "src/version.tas"		;left hand side version number
	.else
		.binary "bin/screen-iec.o64",2		;1541u2cmd
	.fi
		* = scr_version+$03a9
		.include "src/version.tas"		;scroller version number
		
.else
	.if def_iec
		.binary "bin/screen-iec.o64",2		;iec + cmd + ide64 + 1541u
	.else		
		.binary "bin/screen-ser.o64",2		;normal + 1541u2swiec
	.fi		
	
		* = scr_version+$03a9
		.include "src/version.tas"		;scroller version number
.fi	
;--------------------------------------------------------------
		* = $C7e8

;variables 

no_keys		= $ff	;REU only - avoid keyboard while loading dir to reu
crsr_keys	= 3	;crsr-up/down, crsr-left/right
dir_keys	= 5	;crsr-up/down, crsr-left/right, space, delete
noirq_keys	= 6	;return (load file possible)
irq_keys	= 15	;select tune, restart, shuffle


keyCrsrDown	= 0	;Directory keys 0-5
keyCrsrUp	= 1	;
keyCrsrLeft 	= 2	;
keyCrsrRight	= 3	;
keySpace	= 4	;
keyDelete	= 5	;

keyReturn	= 6	;No irq keys    0-6

keyF7		= 7	;IRQ keys	0-15
keyComma	= 8	;          
keyPeriod	= 9	;
keyF1		= 10	;
keyPlus		= 11	;
keyMinus	= 12	;
keyManual	= 13	;
KeyScreenoff	= 14	;
keyNextRandom	= 15	;

;keyboard scan table

dc00
	.byte $be	;00|crsru	
	.byte $be	;01|crsru+sh	
	.byte $be	;02|crsrr+sh	(shift + crsr rt) (left)
	.byte $be	;03|crsrr	(shift + crsr rt is also cleared here)
	.byte $7f	;04|space
	.byte $fe	;05|delete
	.byte $fe	;06|Return
	.byte $fe	;07|F7
	.byte $df 	;08|<
	.byte $df	;09|>
	.byte $FE	;10|F1
	.byte $df	;11|+
	.byte $df	;12|-
	.byte $ef	;13|M
	.byte $fd	;14|S	
	.byte $fb	;15|X

;	.byte $fb	;10|R
;	.byte $ef	;11|N


dc01
	.byte $7f	;00|crsru  
	.byte $6f	;01|crsru+sh  	
	.byte $eb	;02|crsrr+sh 	(left)  Checks both shift + crsr rt
	.byte $fb	;03|crsrr  	(right) Checks crsr rt bit
	.byte $ef	;04|space
	.byte $fe	;05|delete
	.byte $fd	;06|Return
	.byte $f7	;07|F7
	.byte $7f	;08|,
	.byte $ef	;09|.
	.byte $EF	;10|F1
	.byte $fe	;11|+
	.byte $f7	;12|-
	.byte $ef	;13|M
	.byte $df	;14|S	
	.byte $7f	;15|X
	
;	.byte $fd	;10|R
;	.byte $7f	;11|N
	

;-------------------------------------
;
;-------------------------------------
memoryerror	.byte $2c		;stack jump here with Y=ff
dirSelector	ldy #0			;y=0
		jsr wjs_resetCia	;SEI, zp01=$36, Y=not used
		lda #$1b		;screen on
		sta $d011
		tya
		beq +
-		jmp (wjp_fileselect)
;--------------------------------------------------------------
+		lda $dc01
		bpl -			;bpl +			;cmp #$7f RunStop - only key that generates 00-7f
;--------------------------------------------------------------
;LOAD NEW DIR:
start                       		;JMP HERE FIRST TIME from SRC/INIT.TAS

;000c-0100 is zerofilled
;020c-0300 is zerofilled
;X=$ff
;Y=$00


		ldx #2
		stx plt_flag
		lda #$4d		;"M"-anual selection
		sta plt_letter
		lda #<txterror1-1
		sta dzp
		lda screenpos
		clc
		adc #>txterror1&$03ff
		sta dzp+1
		ldy #$26
		lda #$20		;Clear text error area with spacebar
clrmsg2		sta (dzp),y
		dey
		bne clrmsg2


;x=$02
;a=$20
;y=$00

.if !def_reu
;Clear whole zp area - see start of each dir routine:
		sty offs_cursor			;This is for NON reu version only
-		sty $00,x
		inx
		bne -
		lda #>dirpos
		sta dzp+1
;x+y=0		
;y must be zero here:
.fi

;---------------------------------------------------------------
.if def_reu

  .if def_1541u2cmd
		.include src/reu-dir-1541u2cmd.tas
		;ends with zp$01=34
  .else
      .if def_iec
	    	.include src/reu-dir-iec.tas		;iec, ide64 ++
	    	;ends with zp$01=36
      .else		
	    	.include src/reu-dir-read1.tas		;serial 1541 ++
	    	;ends with zp$01=36
      .fi		
  .fi


.else ;def_reu


  .if def_1541u2cmd
		.include src/dir-1541u2cmd.tas		
		;ends with zp$01=35
  .else
      .if def_iec
	    	.include src/dir-iec.tas		;iec, ide64 ++
	    	;ends with zp$01=36
      .else		
	    	.include src/dir-read1.tas		;serial 1541 ++
	    	;ends with zp$01=36
      .fi		
  .fi
.fi ;def_reu

;---------------------------------------------------------------
;At this position the dir loading has finished.
;And zp$01 from above routines can be anything (34,35,36 or 38), as 
;jsr wjs_display below will set it back to $36.

		lda #noirq_keys		;crsrs keys + return key now possible
		sta numb

;Notice that the background code is constantly looping here when playing music and selecting files:

fileSelect
.if DEF_MIX10
        jsr mix10_display     ; wrapper displays native UI then preloads
.else
        jsr wjs_display
.fi
.if DEF_MIX03
                jsr mix03_watch_next ; read-only NEXT candidate tracking
.fi
		sec			;
		bcs fileselect		;JMP
;---------------------------------------------------------------

displayFiles
.if DEF_REU
	.if DEF_1541u2cmd
	.include "src/reu_1541u2cmd_displayfiles.tas"	;custom 1541u2 code
	;zp $01 = 36 on exit
	.else
	.include "src/reu_displayfiles.tas"		;all other versions that use REU.
	;zp $01 = 36 on exit
	.fi
.else
.include "src/displayfiles.tas"				;all versions without reu.
	;zp $01 = 36 on exit
.fi

;zp $01 = 36 and code continues here:

;---------------------------------------------------------------
;  Clock routine
;  Playlist timer with Random or Next load
;  Keyboard scan routine
;  Key checks
;---------------------------------------------------------------
;ffe4key
;TOD Clock is printed to screen:

		lda #<timestr1
		sta gzp
		lda screenpos
		clc
		adc #>timestr1&$03ff
		sta gzp+1

		ldx #2
		ldy #0       ;0-1  3-4  6-7
timeloop	lda $dc09,x  ;dc09,dc0a,dc0b
		pha
		lsr
		lsr
		lsr
		lsr
		ora #$30
		sta (gzp),y
		pla
		iny
		and #$0f
		ora #$30
		sta (gzp),y
		iny
		iny
		dex
		bpl timeloop

;mode is printed to screen:
		ldy #41
		lda plt_letter
		sta (gzp),y

;timer is printed to screen:
		lda #<timestr1+3   ;adjust to minutes, : and seconds only
		sta gzp
            
		ldx #4
		;ldy #40
		dey
-		lda minuteshi-40,y
		sta (gzp),y
		iny
		dex
		bpl -

.if def_illegal
		lax plt_flag		;a+x
.else
		lda plt_flag		
		tax
.fi				
					;A= 0,2 or 81
		and #%01111110		;A= 0,2
		bne scankeys
		tay			;A=0

checkdigits	lda (gzp),y
		cmp minuteshi,y
		beq equ
		bcc scankeys
		bcs plt_advance
equ		iny
		cpy #5
		bne checkdigits

plt_advance

.if DEF_REU
.include "src/reu-plt_function.tas"
.else
.include "src/plt_function.tas"
.fi
	

scankeys

;ctrl_delay = keydelay
;ctrl_cmp   = lastkey

		ldy #$ff
		sty $dc02
		iny
		sty $dc03
            
		lda #<dc00
		sta gzp
		lda #<dc01
		sta rzp
		lda screenpos
		clc
		adc #>dc00&$03ff
		sta gzp+1
		sta rzp+1

		ldy numb     ;04/09/0c/10
.if DEF_REU
		bmi wewait	;Reu version set numb = $ff to avoid any crsr scrolling while reading dir to reu.
.fi
looker		lda (gzp),y
		sta $dc00
		lda (rzp),y	;6f-fe
		cmp $dc01
		beq finner
		dey
		bpl looker

		lda #7
		sta lastkey		;any value not == $ff
		sta keydelay
wewait		rts


finner		
		cpy #keyNextRandom
		bne +
		;x= value from plt_flag above
		;M+R = random
		;N   = next
		cpx #2			;skip on M (= $02)
		beq wewait
		jmp (wjp_pltadvance)
+

		lda #0
		cmp lastkey
		beq thesame	;new key pressed ?
		ldx #15		;yes
		stx keydelay	;set long delay
		bne newchar	;and jump to give Y to keycheckers below
		
thesame				;the same key is being pressed
		dec keydelay	;count 10 or 3 times
		bpl wewait
		ldx #2		;Then we shift to 3 in delay
		stx keydelay

newchar		sta lastkey

;---------------------------------------
		;Y = key we pressed
		;A = must be 0 (some navigate routines expect that)


.if DEF_REU
		.include "src/keys_navigate_REU.tas"
.else
		.include "src/keys_navigate_normal.tas"
.fi



		cpy #keyF7		;"F7	"
		bne tmm
		ldx #14			
-		lda #0		
		sta $d404,x		;standard
secondsid1	bit $d424;,x		;second sid
		lda #$ff		;
		.byte $cb,7		;Illegal opcode sbx #7 (txa,sec,sbc#7,tax):
         	bpl -
		;A=ff			;A is untouched.
		eor stopmusic		;0=    music paused
		sta stopmusic		;1-ff= music on
		ldx #3
-		lda $dc08,x		;8,9,A,B - reading $dc0b here pauses the clock
		sta $dc08,x
		dex
		bpl -
		rts

tmm		ldx #3
		cpy #keycomma		;"<"
		bne chka
hy		cpx #2
		beq skipsemi1
.if def_illegal
		lda #$2f
		dcp minuteshi,x		;saves 3 bytes
		bne spab
.else
		dec minuteshi,x
		lda minuteshi,x
		cmp #$2f
		bne spab
.fi
		lda #$35
		sta minuteshi,x
skipsemi1	dex
		bpl hy
spab		rts     
chka		cpy #keyperiod		;">"
		bne chkb
nextspub	cpx #2
		beq skipsemi2
.if def_illegal
		lda #$36
		sec
		isc minuteshi,x		;saves 2 bytes
		bne spub
.else
		inc minuteshi,x
		lda minuteshi,x
		cmp #$36
		bne spub
.fi
		lda #$30
		sta minuteshi,x
skipsemi2	dex
		bpl nextspub
spub		rts

chkb		cpy #keyManual
		bne plton
		ldy #$4d		;M (x=02)
		lda plt_flag
		beq one		;set one if $00		
		bmi two		;set two if $81
				;set zero if $02
		ldx #0
		iny		;$4e		;N (x=00)
		bne +
		
one		ldx #$81
		ldy #$52		;R (x=81)
		.byte $2c
two		ldx #2			;M

+		stx plt_flag
		sty plt_letter		;NRM on screen
endofkey_check	rts

plton		cpy #KeyScreenoff
		bne kso
		lda $d011
		eor #$10
		sta $d011
		sta bakd011
		rts
		
kso		ldx tune
		cpy #keyF1		;"F1"
		beq restT
		cpy #keyMinus		;"-"
		bne kf
		txa			;zero ?
		beq endofkey_check
		dex
		bpl restT		;0-7f

kf		cpy #keyPlus		;"+"
		bne endofkey_check
		cpx maxtune
		beq endofkey_check
		inx

restT		stx tune		

;table jump here after file is loaded:
restartTune

;zp $01 is always 35 when entering here
		
		;php
		sei
		lda #$38
		sta $01
		jsr dotunenumbers	;uses some zeropages in the 0c-ff area, must set SEI in advance.
	;Returns y = sidslot# for SIDFX
	;Returns Y = sid# for Chameleon

		jsr wjs_resetCia	;SEI, zp01=$36 (clears zp 000c-0100 and 020c-0300)

.if DEF_SIDFX
		sty $d41d		;set SIDFX sidslot#
.fi

.if DEF_CHAMELEON
		sty $d0f4		;set Chameleon sidtype (y:00=old/Y:C0=new)
.fi


;   | Bit 4 |   Force Load Timer A: 1 = Yes
;   | Bit 0 |   Start/Stop Timer A: 1 = Start, 0 = Stop
		;lda #%00010000 ;Stop timer A - latch is on
		lda #%00010001
		sta $dc0e

;It's possible a tune uses the default timer A for a system
;to playback a song. If not the tune init will set it's own $dc04/$dc05 timer.

		lda speedbit	;Check if tune is supposed to play with timer
                                ;0 = no
                                ;1 = yes
		beq nospeed
              
		ldx #$25        ;PAL  - default timer
		ldy #$40
		lda tunesystem  ;Check on what system the tune was made on
		beq unknown     ;1 is pal
		cmp #2          ;2 is ntsc and 3 is both
		bne fixdef
		ldx #$95        ;NTSC - default timer
		ldy #$42
fixdef
unknown		stx $dc04
		sty $dc05
nospeed
		lda #$0f		;force volume because of bad hvsc rips where volume is lost
		sta $d418		;when choosing a sub-tune.

		ldx #zpBuffSize-1	;Buffer
bp1		lda zerop,x		;0002
		sta editbuf,x		;d008
		lda playbuf,x		;d000
		sta zerop,x
		dex
		bpl bp1
					;RSID check:
		lda playmus+1		;Check if playcallplay
		ora playmus+2		;$0000 = no
		bne ownirq		
		
		;A = always 0 (zero)
.if def_basic
		cmp initmus+2		;carry is set if initadress is $0000 (only checking high adress)
.fi
		
              				;this song is played using own interrupt handler
;Does PC sidplay assume zp $01 to be 37 ?
;Maybe we should reset all io registers to default here		
              				
		lda #$1b		;Screen on
		sta $d011
		sta $d020		;Grey border = $0000 SID with no playcall.
.if def_illegal		
		lax tune		;lda tune, tax
.else
		lda tune
		tax
.fi				
		tay

.if def_basic	
		bcc +			;carry check from above
		inc $01		;37
		inc $01		;38
		sta $030c
		ldx #copybas_end-copybas-1
-		lda copybas,x
		sta $0200,x
		dex
		bpl -
		dec $01		;37
		jmp $0200
		
+
.fi
		
		jsr initmus		;This will normally set zeropage $01 to 35,36 or 37

.if def_basic		
exit_basic				;when a basic sid has finshed (ready prompt) it will exit here
					;via the 0300/0301 vectors.
.fi
		
waitk		ldx #0			;ldx #$7f - cbm keyscan also works with 0
		stx $dc00
		lda $dc01
		cmp #$df
		bne waitk
		;sei			;no need, NMI overrides SEI.
		stx $dd0e		;Disable NMI timer A interrupt - These interrupts must be disabled here	
		stx $dd0f		;Disable NMI timer B interrupt
					;We must disable NMI first. Because NMI might contain code that changes zp$01 (Navy moves.sid).
		jsr wjs_resetCia	;SEI, clears cia+nmi, restores 0300-0332 and fffa-fffe, returns with zp $01=36 set
		
		ldx #zpBuffSize-1
bp5		;lda zerop,x		;0002	- 	;|v1.1 we dont need to restore zp for musicplayers
		;sta playbuf,x		;d00x		;|v1.1
		lda editbuf,x		;d00x	- 	only for editor (sp64)
		sta zerop,x		;0002
		dex
		bpl bp5
		txs			;topstack
		jmp (wjp_fileselect)
ownirq         
		dec $01			;zp 01 = 35

.if def_illegal
		lax tune			;lda tune, tax
.else
		lda tune
		tax
.fi				
		tay
		jsr initmus			;might change zp $01 to something else..
		sei
		lda #$35
		sta $01

		ldx #zpBuffSize-1
bp4		lda zerop,x
		sta playbuf,x
		lda editbuf,x
		sta zerop,x
		dex
		bpl bp4
		stx stopMusic			;=FF


		lda speedbit	;0 = nospeed aka vblank
		bne nospeed2	;1 = multispeed

		ldy #$4c	;$4cc7
		ldx #$c7	;PAL - Timer for vblank tunes
		lda tunesystem	;Setup speed according to system it was made on
		cmp #2
		bne fix2
		ldy #$42	;$42c6
		dex		;ldx #$c6  ;NTSC - Timer for vblank tunes
fix2		stx $dc04
		sty $dc05
nospeed2
       
         
wait32		lda #$32
		cmp $d012
		bne wait32
		bit $d011
		bmi wait32

pal_dc0e    = %11010001
ntsc_dc0e   = %01010001
              ;76543210
fixdc0e		lda #%01010001
                        ;bit 0 - Timer a start
                        ;bit 4 - Force latched value to be loaded to Timer A counter
                        ;bit 6 - Serial Port (56332, $DC0C) mode (1=output, 0=input)
                        ;Bit 7:  Time of Day Clock frequency (1=50 Hz required on TOD pin, 0=60 Hz)
                        ;50 hz = pal
                        ;60 hz = ntsc
		sta $dc0e
		;plp
		cli
		rts
            

         


;---------- Load a new file -----------------------------
;jmp wjp_load

load
.if DEF_REU
  .if def_1541u2cmd
  .include src/reu-load-1541u2cmd.tas
