;--------------------------------------------------------------
;         SIDPLAY 64 V.083
;--------------------------------------------------------------
;         Programmed by:
;         Glenn Rune Gallefoss / SHAPE (2005-2013)
;--------------------------------------------------------------
; * All hvsc sids are version 2 or version 3
; * All hvsc sids have a $7c header
; * All hvsc sids use timers dc04/dc05 if speedflag is used
;--------------------------------------------------------------
; $D01A = 0, but enabled when jumping into a song using own interrupt handler.
; $D019 Not used in irq, but enabled when jumping into a song using own interrupt handler.
; $DC0D - The irq is a timer irq, so $dc0d must be read for each irq triggered.
;--------------------------------------------------------------
DEF_REU		= 1	;1 = enable reu routines (for all versions)
def_currentdate	= 1	;1 = include current date and clock in setup
def_illegal	= 1	;1 = use illegal opcodes
def_colorselect	= 1	;use 1, 0 = for debugging new colors.
def_attractmode = 2	;0 = no attract mode, 1= basic attract mode, 2 = smooth attract mode
;--------------------------------------------------------------
;compile like this:
;64tass --m6502 -D defset=1 -a sidplay64.tas -o sidplay64-normal.o64

.include sidplay64.cfg	;see this file for defset's

;--------------------------------------------------------------
;         Kernal Addresses and other definitions:
;--------------------------------------------------------------
.include src/kernal.tas		;list of useful kernal adresses
.include src/1541u2_defines.tas ;list of 1541u2 addressing
.if DEF_REU
.include src/reu_defines.tas
.fi

;--------------------------------------------------------------
;         Zeropages used during DISK I/O:
;--------------------------------------------------------------
header		= $0c
magicID		= header	;+00 - 4 bytes	- "psid" or"rsid"
version		= header+$04	;+04 - word	-  version 0001/0002/0003 (rsid+psid v2ng)
dataoffset	= header+$06	;+06 - word	- dataoffset to the c64 binary
loadAddress	= header+$08	;
initAddress	= header+$0a
playAddress	= header+$0c
songs		= header+$0e
startSong	= header+$10
speed		= header+$12
sidname		= header+$16
sidauthor	= header+$36
sidreleased	= header+$56
v1data
flags		= header+$76
startPage	= header+$78   ;at 84
pageLength	= header+$79   ;at 85
reserved	= header+$7a
v2data
v2loadaddress	= header+$7c ;binary loadadress

status		= $90 ;

endAdrHi	= $af	;$f0 ;|
endAdrLo	= $ae	;$f1 ;|

ldzp		= endAdrLo	;For 1541u2 only - same as zp $ae,af

netdrivex	= $f1
countdir	= $f2	;Zp dir sorter
countfile	= $f3	;Zp dir sorter
tmp		= $f4 ;
relocsize	= $f5 ;
startbank	= $f6 ;
dzp		= $fc ;|word - zp for reading in new directory
loadAdrLo	= $fe ;|Startadress - header offset ($76 or $7c)
loadAdrHi	= $ff ;|


;--------------------------------------------------------------
;         Zeropages used during play and irq:
;--------------------------------------------------------------

pos_cursor	= $02	;Visible # limit for filenames
zerop		= pos_cursor
maxfile		= $03	;Keeps track of # of files in memory
gzp		= $04	;word
rzp		= $06	;word
;tzp		= $08	;word
;--------------------------------------------------------------
firstzp		= pos_cursor
lastzp		= rzp+1

zpBuffSize	= ( lastzp - firstzp) +1 ;9 end of zeropage address 

zpclear		= zpBuffsize + 3	;$0008-$00ff

;stackClear	= zpBuffSize + 1	- unused?
;--------------------------------------------------------------
;zps in void: 08,09,0a,0b
speedbit	= $08;tzp	;byte	- note : this zp is updated by dotunenumbers.tas and should not be zerofilled by "ciareset"
			;       make it point to $08 when tzp has been removed/changed


;-------- Safe Zeropages when restarting a tune (000c-0100 is zero filled during init)

bcd		= $0c	;|word	- dotuneumbers.tas
bin		= bcd+2	;|word  - dotuneumbers.tas
bincount	= bin+2 ;|byte  - dotuneumbers.tas

;--------------- static memory adressing:
fname		= $0200
playBuf		= $d000		;d000-d007
editBuf		= $d008		;d008-d00f
offs_cursor	= $d017		;Offset for filenames

keydelay	= $d010
seed		= $d01c
lastkey		= $d01d

;d015	;cant use
;d01b	;free
;d01c	;free

;--------------------------------------------------------------
;         SIDPLAY64 STACK JUMPS, TABLES, DATA
;--------------------------------------------------------------
topstack	= $ff        ;$01fb

               * = $1100
stack 
               * = $0115
               .offs stack-*
stacker


numb		.byte dir_keys		;low nibble only (numb uses 00-0e )

minuteshi	.byte $30
minuteslo	.byte $33
		.byte $3a   ;:
secondshi	.byte $30
secondslo	.byte $35

;\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\
wjs_jumps
.if DEF_REU
wjs_exe_reucomm	jmp execute_reu_command ;00-jmp $XX00
.else
wjs_playlist	jmp plt_inc         ;00-jmp $XX00
.fi
wjs_restartTune	jmp restartTune     ;01-jmp $XX00
wjs_resetCia	jmp resetCia        ;03-jmp $XX00
wjs_display	jmp displayfiles    ;05-jmp $XX00
.if def_1541u2cmd
wjs_wait_while_busy jmp wait_while_busy ;06-jmp $XX00
.else
wjs_getbyte	jmp getbyte         ;06-jmp $XX00
.fi
stack_irq	jmp irq             ;07-jmp $XX00	fffe/ffff
stack_hwirq	jmp hwirq           ;08-jmp $XX00	0314/0315
;\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\
stack_nmi	sei					;0318+fffa
		ldx #topstack
		txs
		inx
		stx $d020             ;0
		jmp (wjp_dirselector) ;nmi

;\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\
wjs_add		
.if DEF_REU
		.byte >(execute_reu_command-screen2);highbyte Offset from screen
.else
		.byte >(plt_inc-screen2)      ;highbyte Offset from screen
.fi
		.byte >(restartTune-screen2)  ;highbyte Offset from screen
		.byte >(resetCia-screen2)     ;highbyte Offset from screen
		.byte >(displayfiles-screen2) ;highbyte Offset from screen
.if def_1541u2cmd
		.byte >(wait_while_busy-screen2)      ;highbyte Offset from screen
.else
		.byte >(getbyte-screen2)      ;highbyte Offset from screen
.fi
		.byte >(irq-screen2)          ;highbyte Offset from screen
		.byte >(hwirq-screen2)        ;highbyte Offset from screen
;\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\
initMus		jmp initMus        ;jmp $xxxx
playMus		jmp playMus        ;jmp $xxxx
stopMusic	.byte 0            ;byte 1-ff = music on... 0 = music off

wjp_dirselector	.word dirselector  ;00-word - jmp direselector
wjp_fileselect	.word fileselect   ;01-word - jmp fileselect
wjp_load	.word load         ;02-word - jmp load
wjp_pltadvance	.word plt_advance  ;03-word - jmp plt_advance

wjp_add		.byte >(dirselector-screen2)  ;highbyte Offset from screen
		.byte >(fileselect-screen2)   ;highbyte Offset from screen
		.byte >(load-screen2)         ;highbyte Offset from screen
		.byte >(plt_advance-screen2)  ;highbyte Offset from screen

screenpos	.byte $C4
fontpos		.byte $e0

device		.byte 0
plt_flag	.byte 2              ;$02 = manual select (color red too)
                                     ;$00 = shuffle to next
                                     ;$80 = shuffle random
plt_letter	.byte $4d             ;M,N,R                                     
samefile	.byte 0
tune		.byte 0              ;|Should stay
maxtune		.byte 0              ;|next to each other

speedtimer	.byte 0,0,0,0        ;0 bit = standard irq
                                     ;1 bit = dc04/dc05 
                                     
tunesystem	.byte 1              ;00 = unknown  bits 1,0  byte $00
                                     ;01 = pal      bits 1,0  byte $01
                                     ;10 = ntsc     bits 1,0  byte $02
                                     ;11 = both     bits 1,0  byte $03
.if def_1541u2cmd
wait_for_idle
-		lda U2_Status_register
		and #_STATE
		bne -
		rts
get_status	lda #<txterror1
		sta rzp
		lda screenpos
		clc
		adc #>txterror1&$03ff
		sta rzp+1
;		ldy #38-1
;		lda #$20	;clear "dos" error message area
;-		sta (rzp),y
;		dey
;		bpl -
;		iny
		ldy #$00
		
		bit U2_Status_register
		bvc nostatus			; no message - don't clear status, leave it
-		bit U2_Status_register
		bvc +				; if finished clear the rest of the line
		lda U2_Staus_data_register
		sta (rzp),y
		iny				;$0100 status mesage ?  
		bne -
+
; clear area				
-		cpy #38
		bcs nostatus
		lda #$20	;clear "dos" error message area
		sta (rzp),y
		iny
		bne -
nostatus		
		rts
		
.else
panic_load				;zp $01 = 36
				
		lda #$38
		sta $01

		ldx #5
copyp2		lda panic_0314,x	;0314,15,16,17,18,19
		sta $0314,x		;Buffer irq vectors for panic load
		dex
		bpl copyp2
		lda #$36
		sta $01
           	ldx loadAdrLo
panicload	lda #1			;For cases where ther is no memory and sid is a rsid (playaddress $0000):
					;We change panicload+1 to zero, load the file, run it and hope for the best.  No exit to sp64.

		jsr ROM_load
.if def_illegal
		lax tune
.else
		lda tune
		tax
.fi		
		tay
		;sei
		;ldy #$36
		;sty $01
;panicinit	jsr *
		jsr initmus
		jmp *
.fi
;----------------------0123456789abcdef01234
.if DEF_REU
.else
nofile		.text "no files present!    "	;present here in the normal non-reu version
.fi
;----------------------0123456789abcdef012
              
;-------------------------
.if def_iec
diskimage			;IEC - 1-ff no disk image, 0 = disk image
zerofile	.byte 0		;IEC - used in dir-load to check if a file has zero blocks
dircommand
.text "cd:"			;IEC - open dir
dirname				;IEC - dirname to open
.fi
;-------------------------
endstacker
              * = *-stacker+stack
              .offs 0


		
		* = $9000
;--------------------------------------------------------------
;         SIDPLAY64 INITIAL RUN
;--------------------------------------------------------------
;         This code is only runned once to 
;         setup stack, colors, memory, code.
;         Jumps to label "start" to begin sidplay64.
;--------------------------------------------------------------
;Sidplay64 is started with a call to $c000  on startup:
.if def_colorselect
.include src/init.tas
.else
.include src/init2.tas	;just for testing new colors
.fi
.include src/devicecheck.tas
.include src/joyport1.tas
;.include src/joyport2.tas
.if DEF_REU
reu_detection
.include src/reu_detect.tas
.fi


.align $0100
attract_mode
.if def_attractmode = 1
.include src/attract_mode2.tas
.fi
.if def_attractmode = 2
.include src/irq-attract-mode.tas
.fi

;--------------------------------------------------------------



;--------------------------------------------------------------
;         SIDPLAY64 
;--------------------------------------------------------------
;         Program
;--------------------------------------------------------------
screen1		= $0400
screen2		= $c400
screen2chars	= $e000 ;e000-e800
;-----------
.if def_1541u2cmd*DEF_REU
credz		= (screen1&$03ff)+($d807+(40*3))	;|REU
songstr1	= screen1+(40*6)+7			;|
timestr1	= screen1+(40*20)+4			;|
dirscreen	= screen2+(40*7)+13			;|
;-----------
.else
credz		= (screen1&$03ff)+($d808+(40*3))
songstr1	= screen1+(40*6)+8
timestr1	= screen1+(40*20)+9
dirscreen	= screen2+(40*7)+18
.fi
;-----------
txterror1	= screen1+$0399
maxDirY		= 15




;--------------------------------------------------------------

		* = $c400
.if def_1541u2cmd
	.if def_reu
		.binary "bin/screen09-1541u2reu.o64",2		;1541u2cmd reu version
	.else
		.binary "bin/screen09-iec.o64",2		;1541u2cmd
	.fi
		
.else
	.if def_iec
		.binary "bin/screen09-iec.o64",2		;iec + cmd + ide64 + 1541u
	.else		
		.binary "bin/screen09-ser.o64",2		;normal + 1541u2swiec
	.fi		
.fi	
;--------------------------------------------------------------
		* = $C7e8

;variables 

no_keys		= $ff	;REU only - avoid keyboard while loading dir to reu
dir_keys	= 5	;crsr-up/crsr-down/clrhome/sh+clrhome/space/delete
noirq_keys	= 6	;return (load file possible)
irq_keys	= 14	;select tune, restart, shuffle


keyCrsrDown	= 0	;Directory keys 0-5
keyCrsrUp	= 1	;
keyCrsrLeft 	= 2	;
keyCrsrRight	= 3	;
keySpace	= 4	;
keyDelete	= 5	;

keyReturn	= 6	;No irq keys    0-6

keyF7		= 7	;IRQ keys	0-15
keyComma	= 8	;          
keyPeriod	= 9	;
keyF1		= 10	;
keyPlus		= 11	;
keyMinus	= 12	;
keyManual	= 13	;
KeyScreenoff	= 14	;

;keyRandom	= 10	;
;keyNext	= 11	;
;keyboard scan table

dc00


	.byte $be	;00|crsru	
	.byte $be	;01|crsru+sh	
	.byte $be	;02|crsrr+sh	(shift + crsr rt) (left)
	.byte $be	;03|crsrr	(shift + crsr rt is also cleared here)
	.byte $7f	;04|space
	.byte $fe	;05|delete
	.byte $fe	;06|Return
	.byte $fe	;07|F7
	.byte $df 	;08|<
	.byte $df	;09|>
	.byte $FE	;10|F1
	.byte $df	;11|+
	.byte $df	;12|-
	.byte $ef	;13|M
	.byte $fd	;14|S	

;	.byte $fb	;10|R
;	.byte $ef	;11|N


dc01

	.byte $7f	;00|crsru  
	.byte $6f	;01|crsru+sh  	
	.byte $eb	;02|crsrr+sh 	(left)  Checks both shift + crsr rt
	.byte $fb	;03|crsrr  	(right) Checks crsr rt bit
	.byte $ef	;04|space
	.byte $fe	;05|delete
	.byte $fd	;06|Return
	.byte $f7	;07|F7
	.byte $7f	;08|,
	.byte $ef	;09|.
	.byte $EF	;10|F1
	.byte $fe	;11|+
	.byte $f7	;12|-
	.byte $ef	;13|M
	.byte $df	;14|S	

;	.byte $fd	;10|R
;	.byte $7f	;11|N
	

;-------------------------------------
;
;-------------------------------------
memoryerror	.byte $2c		;stack jump here with Y <> 0
dirSelector	ldy #0
		jsr wjs_resetCia	;Y = not used, zp 01 = $36
		lda #$1b		;screen on
		sta $d011
		tya			;instead of cpy #0
		beq dodir
		jmp (wjp_fileselect)
;--------------------------------------------------------------
;LOAD NEW DIR:

start                       		;JMP HERE FIRST TIME from SRC/INIT.TAS

dodir		lda #2
		sta plt_flag
		lda #$4d		;"M"-anual selection
		sta plt_letter
		lda #<txterror1
		sta dzp
		lda screenpos
		clc
		adc #>txterror1&$03ff
		sta dzp+1
		ldy #$25
		lda #$20		;Clear text error area with spacebar
clrmsg2		sta (dzp),y
		dey
		bpl clrmsg2




.if def_reu

  .if def_1541u2cmd
		.include src/reu-dir-1541u2cmd.tas
  .else
      .if def_iec
	    	.include src/reu-dir-iec.tas		;iec, ide64 ++
      .else		
	    	.include src/reu-dir-read1.tas		;serial 1541 ++
      .fi		
  .fi


.else ;def_reu


  .if def_1541u2cmd
		.include src/dir-1541u2cmd.tas
  .else
      .if def_iec
	    	.include src/dir-iec.tas		;iec, ide64 ++
      .else		
	    	.include src/dir-read1.tas		;serial 1541 ++
      .fi		
  .fi
.fi ;def_reu

;Set Help, Dir, Load keys:
;and wait for user

		lda #noirq_keys  ;*9
		sta numb
            
fileSelect	jsr wjs_display		;DisplayFiles+keys
.if DEF_REU
		lda #$36
		sta $01
.fi
		
		;lda #$1b		;orignally we 
		;sta $d011		;set d011 here all the time
		;bne fileSelect		;JMP

		sec			;SLC screen onoff
		bcs fileselect		;SLC screen onoff (JMP)
		

; Dir-buffer is located at $d000 ->


displayFiles
.if DEF_REU
	.if DEF_1541u2cmd
	.include "src/reu_1541u2cmd_displayfiles.tas"	;custom 1541u2 code
	.else
	.include "src/reu_displayfiles.tas"		;all other versions that use REU.
	.fi
.else
.include "src/displayfiles.tas"				;all versions without reu.
.fi
;zp $01 = 36 and code continues here:

;---------------------------------------
;  Keyboard scan routine with delay
;  Inserted clock routine + random+next load here to free up cpu time for irq speed calls
;---------------------------------------

;zp $01 = 36 here

ffe4key

;TOD Clock is printed to screen:
		lda #<timestr1
		sta gzp
		lda screenpos
		clc
		adc #>timestr1&$03ff
		sta gzp+1

		ldx #2
		ldy #0       ;0-1  3-4  6-7
timeloop	lda $dc09,x  ;dc09,dc0a,dc0b
		pha
		lsr
		lsr
		lsr
		lsr
		ora #$30
		sta (gzp),y
		pla
		iny
		and #$0f
		ora #$30
		sta (gzp),y
		iny
		iny
		dex
		bpl timeloop

;mode is printed to screen:
		ldy #41
		lda plt_letter
		sta (gzp),y

;timer is printed to screen:
		lda #<timestr1+3   ;adjust to minutes, : and seconds only
		sta gzp
            
		ldx #4
		;ldy #40
		dey
-		lda minuteshi-40,y
		sta (gzp),y
		iny
		dex
		bpl -

.if def_illegal
		lax plt_flag		;a+x
.else
		lda plt_flag		
		tax
.fi				
					;A= 0,2 or 81
		and #%01111110		;A= 0,2
		bne scankeys
		tay			;A=0

checkdigits	lda (gzp),y
		cmp minuteshi,y
		beq equ
		bcc scankeys
		bcs plt_advance
equ		iny
		cpy #5
		bne checkdigits

plt_advance

.if DEF_REU
.include "src/reu-plt_function.tas"
.else
.include "src/plt_function.tas"
.fi
	

scankeys

;ctrl_delay = keydelay
;ctrl_cmp   = lastkey

		ldx #$ff
		stx $dc02
		inx
		stx $dc03
            
		lda #<dc00
		sta gzp
		lda #<dc01
		sta rzp
		lda screenpos
		clc
		adc #>dc00&$03ff
		sta gzp+1
		sta rzp+1

		ldy numb     ;04/09/0c/10
.if DEF_REU
		bmi wewait	;Reu version set numb = $ff to avoid any crsr scrolling while reading dir to reu.
.fi
looker		lda (gzp),y
		sta $dc00
		lda (rzp),y
		cmp $dc01
		beq finner
		dey
		bpl looker

		lda #10
		sta lastkey		;any value not == $ff
		sta keydelay
wewait		rts


finner		lda #0
		cmp lastkey
		beq thesame	;new key pressed ?
		ldx #10		;yes
		stx keydelay	;set long delay
		bne newchar	;and jump to give Y to keycheckers below
		
thesame				;the same key is being pressed
		dec keydelay	;count 10 or 3 times
		bpl wewait
		ldx #3		;Then we shift to 3 in delay
		stx keydelay

newchar		sta lastkey	;A=FF = CTRL note (see notetable)

;---------------------------------------
		;Y = key we pressed
		;A = 0

.if DEF_REU
		.include "src/keys_navigate_REU.tas"
.else
		.include "src/keys_navigate_normal.tas"
.fi

		cpy #keyF7		;"F7	"
		bne tmm
		ldx #14			
-		lda #0		
		sta $d404,x		;standard
secondsid1	bit $d424;,x		;second sid
		lda #$ff		;
		.byte $cb,7		;Illegal opcode sbx #7 (txa,sec,sbc#7,tax):
         	bpl -

		lda stopmusic		;0 = pause
		eor #$ff		;1-ff = unpause
		sta stopmusic	
		ldx #3
-		lda $dc08,x		;8,9,A,B - reading $dc0b here pauses the clock
		sta $dc08,x
		dex
		bpl -
		rts

tmm		ldx #3
		cpy #keycomma		;"<"
		bne chka
hy		cpx #2
		beq skipsemi1
.if def_illegal
		lda #$2f
		dcp minuteshi,x		;saves 3 bytes
		bne spab
.else
		dec minuteshi,x
		lda minuteshi,x
		cmp #$2f
		bne spab
.fi
		lda #$35
		sta minuteshi,x
skipsemi1	dex
		bpl hy
spab		rts     
chka		cpy #keyperiod		;">"
		bne chkb
nextspub	cpx #2
		beq skipsemi2
.if def_illegal
		lda #$36
		sec
		isc minuteshi,x		;saves 2 bytes
		bne spub
.else
		inc minuteshi,x
		lda minuteshi,x
		cmp #$36
		bne spub
.fi
		lda #$30
		sta minuteshi,x
skipsemi2	dex
		bpl nextspub
spub		rts

chkb		cpy #keyManual
		bne plton
		ldy #$4d		;M (x=02)
		lda plt_flag
		beq one		;set one if $00		
		bmi two		;set two if $81
				;set zero if $02
		ldx #0
		iny		;$4e		;N (x=00)
		bne +
		
one		ldx #$81
		ldy #$52		;R (x=81)
		.byte $2c
two		ldx #2			;M

+		stx plt_flag
		sty plt_letter		;NRM on screen
endofkey_check	rts

.comment
chkb		lda #2
		ldx #$4d		;"M"-anual selection
		cpy #keyManual
		beq skmanual
		lda #0
		ldx #$4e		;"N"-ext (loads next song in dir list)
		cpy #keyNext
		beq sknext
		
		cpy #keyRandom		;"R"-andom (loads random song in dir list)
		bne plton
		lda #$80
		ldx #$52		

sknext
skmanual	sta plt_flag
		stx plt_letter
		rts
.endc		


plton
		cpy #KeyScreenoff
		bne kso
		lda $d011
		eor #$10
		sta $d011
		rts
		
kso		ldx tune
		cpy #keyF1		;"F1"
		beq restT
		cpy #keyMinus		;"-"
		bne kf
		txa			;zero ?
		beq endofkey_check
		dex
		bpl restT		;0-7f

kf		cpy #keyPlus		;"+"
		bne endofkey_check
		cpx maxtune
		beq endofkey_check
		inx

restT		stx tune		

;table jump here after file is loaded:
restartTune

;zp $01 is always 35 when entering here
		
		php
		sei
		lda #$38
		sta $01
		jsr dotunenumbers
;		lda #$35
;		sta $01


		jsr wjs_resetCia	;zp 01 = 36 (clears zp 000c-0100 and 020c-0300)

;   | Bit 4 |   Force Load Timer A: 1 = Yes
;   | Bit 0 |   Start/Stop Timer A: 1 = Start, 0 = Stop
		;lda #%00010000 ;Stop timer A - latch is on
		lda #%00010001
		sta $dc0e


;It's possible a tune uses the default timer A for a system
;to playback a song. If not the tune init will set it's own $dc04/$dc05 timer.

		lda speedbit	;Check if tune is supposed to play with timer
                                ;0 = no
                                ;1 = yes
		beq nospeed
              
		ldx #$25        ;PAL  - default timer
		ldy #$40
		lda tunesystem  ;Check on what system the tune was made on
		beq unknown     ;1 is pal
		cmp #2          ;2 is ntsc and 3 is both
		bne fixdef
		ldx #$95        ;NTSC - default timer
		ldy #$42
fixdef
unknown
		stx $dc04
		sty $dc05
		
nospeed





		lda #$0f		;force volume because of bad hvsc rips where volume is lost
		sta $d418		;when choosing a sub-tune.

		ldx #zpBuffSize-1	;Buffer
bp1		lda zerop,x
		sta editbuf,x
		lda playbuf,x
		sta zerop,x
		dex
		bpl bp1
					;RSID check:
		lda playmus+1		;Check if playcallplay
		ora playmus+2		;= $0000 ?
		bne ownirq
              				;yes
              				;Does PC sidplay assume zp $01 to be 37 ?

		;lda #$36		;Ram 0000-D000
		;sta $01
		;Maybe we should reset all io registers to default here		
		;jsr wjs_resetCia
		;LDA #$11
		;STA $DC0E
              				
		lda #$1b		;Screen on
		sta $d011
		sta $d020		;Grey border = $0000 SID with no playcall.
.if def_illegal		
		lax tune		;lda tune, tax
.else
		lda tune
		tax
.fi				
		tay
		jsr initmus		;This will normally set zeropage $01 to 35,36 or 37
waitk		;ldx #$7f		;saves 2 bytes - 
		ldx #0			;cbm keyscan also works with 0
		stx $dc00
		lda $dc01
		cmp #$df
		bne waitk

		sei	
		;ldx #0
		stx $dd0e		;Disable NMI timer A interrupt - These interrupts must be disabled here	
		stx $dd0f		;Disable NMI timer B interrupt
		stx $d020		;black screen
		
		lda #$35		;
		sta $01
		
;		ldx #topstack
;		txs
		ldx #zpBuffSize-1
bp5		lda zerop,x
		sta playbuf,x
		lda editbuf,x
		sta zerop,x
		dex
		bpl bp5
		jsr wjs_resetCia		;restores 0300-0332 and fffa-fffe
		txs			;topstack
		jmp (wjp_fileselect)
ownirq         
		dec $01			;zp 01 = 35

.if def_illegal
		lax tune			;lda tune, tax
.else
		lda tune
		tax
.fi				
		tay
		jsr initmus			;might change zp $01 to something else..
		sei
		lda #$35
		sta $01

		ldx #zpBuffSize-1
bp4		lda zerop,x
		sta playbuf,x
		lda editbuf,x
		sta zerop,x
		dex
		bpl bp4
		stx stopMusic			;=FF


		lda speedbit	;0 = nospeed aka vblank
		bne nospeed2	;1 = multispeed

		ldy #$4c	;$4cc7
		ldx #$c7	;PAL - Timer for vblank tunes
		lda tunesystem	;Setup speed according to system it was made on
		cmp #2
		bne fix2
		ldy #$42	;$42c6
		dex		;ldx #$c6  ;NTSC - Timer for vblank tunes
fix2		stx $dc04
		sty $dc05
nospeed2
       
         
wait32		lda #$32
		cmp $d012
		bne wait32
		bit $d011
		bmi wait32

pal_dc0e    = %11010001
ntsc_dc0e   = %01010001
              ;76543210
fixdc0e		lda #%01010001
                        ;bit 0 - Timer a start
                        ;bit 4 - Force latched value to be loaded to Timer A counter
                        ;bit 6 - Serial Port (56332, $DC0C) mode (1=output, 0=input)
                        ;Bit 7:  Time of Day Clock frequency (1=50 Hz required on TOD pin, 0=60 Hz)
                        ;50 hz = pal
                        ;60 hz = ntsc
		sta $dc0e
		plp
		rts
            

         


;---------- Load a new file -----------------------------
;jmp wjp_load

load
.if DEF_REU
  .if def_1541u2cmd
  .include src/reu-load-1541u2cmd.tas
  .else
  .include src/reu-load-iec-serial.tas
  .fi
.else
  .if def_1541u2cmd
  .include src/load-1541u2cmd.tas
  .else
  .include src/load-iec-serial.tas
  .fi
.fi ;DEF_REU
		lda magicid+1
		cmp #$53		;pSid/rSid
		beq idook
file_error	ldx plt_flag
		beq donext		;0   next
		bmi donext   		;80+ random
		stx $d020
		jmp (wjp_dirselector)
donext		jmp (wjp_pltadvance)	;try next file in dir
;siderror	jmp (wjp_fileselect)	;return to fileselector - this sid is using $0000 as play address - unfortunately with all keys on.
         
idook		

		lda playAddress+1	;lo part of play call
		ora playAddress		;hi part of play call (checking for $0000 which is typical for RSID.. and only a few PSID)
skiprsid	beq file_error		;$24;siderro	;wrong sid type
		
		sei			;! Must set SEI here, because we do a stack jump to "returnhere"
		lda #$38		;! or we do a stack jump to
		sta $01
		jmp doheaderstuff	;src/doheaderstuff.tas

returnHere                      ;returns with stackjump here from doheaderstuff
		lda #$36
		sta $01

;Find correct $dd00

.if def_illegal
		lax screenpos	;lda,tax
		alr #%11000000	;and #, lsr
				;saves 1 byte
		lsr
		lsr
		lsr
		lsr
		lsr

.else
		lda screenpos
		tax
		and #%11000000
		lsr
		lsr
		lsr
		lsr
		lsr
		lsr
.fi		             
		
		eor #%00000011
		sta $dd00
		tay
                
;Find correct $d018
;Locate videoram pointer (screen 0400-07e8)

		txa 
		and #$3f
		asl
		asl
		sta tmp
;Locate charset pointer (font 2000-2800)
		lda #%00000110 ;Rom font (1000/9000)
		cpy #3         ;0000-4000
		beq romchar
		cpy #1         ;8000-c000
		beq romchar
		
		lda fontpos    ;Banks 4000-8000 and c000-00000
		sta gzp+1
.if def_illegal
		alr #$3f	;and #, lsr
				;saves 1 byte
		lsr
.else
		and #$3f       ;Needs a copy of the romcharset
		lsr
		lsr
.fi
		pha
		lda #$33
		sta $01
		lda #$d8
		sta rzp+1
	
		ldx #8		;7 pages of font to copy
		ldy #0
		sty rzp
		sty gzp
RRomset		lda (rzp),y
		sta (gzp),y
		iny
		bne RRomset
		inc rzp+1
		inc gzp+1
		dex
		bne RRomset
		
		lda #$36
		sta $01
		
		pla
		
romchar		ora tmp
		sta $d018

;-- Adjust jmp's to new screenpos:

		ldx #3*2                 ;0,1,2,3,4 entries
		ldy #3
adjust1		lda screenpos
		clc
		adc wjp_add,y
		sta wjp_dirselector+1,x
		dey
		dex
		dex
		bpl adjust1

;-- Adjust jsr's to new screenpos:

		ldx #6*3                ;0,1,2,3,4,5,6,7,8 entries
		ldy #6
adjust2		lda screenpos
		clc
		adc wjs_add,y
		sta wjs_jumps+2,x
		dey
		dex
		dex
		dex
		bpl adjust2
           
;load file into mem

.if def_1541u2cmd
; Read remaining stuff here
		;lda v2loadaddress	- load adress is set in src/doheaderstuff.tas
		;sta ldzp
		;lda v2loadaddress+1
		;sta ldzp+1

		jsr wait_for_idle

		lda #$01
		sta U2_Command_data_register
		lda #_DOS_CMD_READ_DATA
		sta U2_Command_data_register
		lda #$ff
		sta U2_Command_data_register
		lda #$ff
		sta U2_Command_data_register
		lda #_PUSH_CMD
		sta U2_Control_register

		ldy #0
nextpacket2
		jsr wjs_wait_while_busy		
		
-		lda U2_Status_register          ; any data left to process int this packet ?
		bpl nomorechars2
		lda U2_Response_data_register   ; yes - print it
		
		; A = DATA here
		sta (ldzp),y			;zp $01 = 36 - Can safely write to 0000-cfff and e000-ffff
		inc ldzp
		bne -
		inc ldzp+1
		bne -				;(jmp) never zero
		
nomorechars2

		jsr get_status

		lda #_DATA_ACC                  ; Go to next packet, if any
		sta U2_Control_register
		lda U2_Status_register
		and #_STATE
		cmp #_STATE_COMMAND_BUSY        ; check if there is any more packets to process
		beq nextpacket2
		
;ldzp = endAdrLo and now contains the end load adress.


.else
		lda #0
		sta $90			;TESTING - Will this fix sd2iec loading problems ?
		sta $b9			;IDE64 again
           	ldx loadAdrLo
		ldy loadAdrHi
		lda panicload+1		;A = 0 on panic
		bne nopanic
		jmp panic_load
nopanic		lda #0
		jsr ROM_load		;Returns X = endadr lo
					;Returns Y = endadr hi
		;stx endAdrLo
		;sty endAdrHi
.endif

