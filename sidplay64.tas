		sta $0314,x	;0314-0331 (doesnt include the save vectors)
		dex
		bpl -
		lda #$36	;sta $01
		rts
.if def_basic
copybas		ldx #$fa	;| Have to change top of stack...
		txs		;| ... because of basic stack area at 01fc,y
		lda #$31
		sta $0314
		lda #$ea
		sta $0315
		jsr $fd5f	;fd50 - Initialise System Constants (some zeropages and $0288, $0284)
basicendlo	lda #0
		sta $ae
		sta $2d
basicendhi	lda #0
		sta $af
		sta $2e		
		jsr $e453	; initialize vectors (0300-030b)
		jsr $e3bf	; initialize basic ram
		lda #<exit_basic
		sta $0300
		lda #>exit_basic
		sta $0301
    		jsr $a659	; (a68e: set program pointer to basic-start)
    		jmp $a7b1	; basic warm start - without stop key check - originally we use $a7ae
copybas_end    		
.fi
		
