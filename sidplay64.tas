errormsg


		sei
		lda #$38
		sta $01

		lda #$45
		sta gzp
		lda screenpos		;0445/0845/0c45...c445
		sta gzp+1

		ldy #3
		lda v2loadaddress
		jsr printhexnum		;tzp
		lda v2loadaddress+1
		jsr printhexnum		;tzp
        
		ldy #9
		lda endAdrLo
		jsr printhexnum		;tzp
		lda endAdrHi
		jsr printhexnum		;tzp

;------> initialize loaded file <--------------
		;jsr wjs_resetCia	;clear all zeropage memory - important!
