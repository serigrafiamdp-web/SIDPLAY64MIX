printhexnum	jsr gethexnum
		sta (gzp),y
		dey
		txa
		sta (gzp),y
		dey
		rts

gethexnum	pha
		lsr
		lsr
		lsr
		lsr
		jsr hex2sa
		tax
		pla
		and #$0f
hex2sa		ora #$30
		cmp #$3a
		bmi hex2sb
		adc #$06
hex2sb		rts

dotunenumbers
