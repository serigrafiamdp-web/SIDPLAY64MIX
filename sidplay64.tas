cia_reset2_part2		;Called by src/cia_reset3.tas

		stx $0291	;>80 = disable cbm+shift		
		;lda #$48	;|jmp ($pointer) to keyboard table
		sta $028f	;|This must be on incase its an rsid using jmp $ea31 in the interrupt handler
		lda #$eb	;|	part of jump pointer to keyboard table
		sta $0290	;|

color_screen2	lda #$a9	;fixes color cursor blinking on certain rsids
		sta $0286
		
my02a6		lda #0		;Restore pal/ntsc flag wiht its real value
		sta $02a6	;Edvin van santens player checks this register for pal/ntsc

		lda #<stack_nmi
		ldx #>stack_nmi        ;All irq's are on the same page $0100-$0190 somewhere
		sta $fffa
		stx $fffb
		lda #<stack_irq
		sta $fffe
		stx $ffff

		ldx #$1d
-		lda vectors,x	;0314+0318 has correct vectors
		sta $0314,x	;0314-0331 (doesnt include the save vectors)
		dex
		bpl -
